---
// Internal preview for the home page's day story (noindex, out of the sitemap). OWNER: home-daystory.
// Paper above and below, as on Home (Outcomes before it, Services after it), so the pin has room.
import BaseLayout from '@/layouts/BaseLayout.astro';
import DayStory from '@/components/home/DayStory.astro';
---
<BaseLayout title="Day story (preview)" noindex>
  <section class="section">
    <div class="wrap dsp">
      <p class="eyebrow">Dev preview</p>
      <h1 class="type-h1">A day with your AI workforce</h1>
      <p class="type-lead">The pinned scroll story from Home. Scroll down: on wide screens the stage pins and the clock moves; on phones, with reduced motion or without JS it is a static sequence.</p>
    </div>
  </section>
  <DayStory />
  <section class="section">
    <div class="wrap dsp">
      <p class="type-lead">After the story: the next Home section (Services) starts here.</p>
    </div>
  </section>
</BaseLayout>

<style>
  .dsp { display: grid; gap: 16px; min-height: 40vh; align-content: start; }
</style>
