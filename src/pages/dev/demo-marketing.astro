---
// Preview page for the Marketing Director demo (noindex, excluded from the sitemap). OWNER: demo-marketing.
// The demo alone on a plain page, for visual QA: node scripts/shot.mjs <this url> --out .shots/demo-marketing
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/ui/Section.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import MarketingDemo from '@/components/demos/MarketingDemo.astro';
---
<BaseLayout title="Marketing Director demo" noindex>
  <main id="main">
    <Section id="demo-marketing" tone="sunken" size="tight" aria-labelledby="demo-marketing-title">
      <Eyebrow>Demo preview</Eyebrow>
      <h1 id="demo-marketing-title" class="type-h3 mt-3">Marketing Director: ad waste found, tests run, cost per new patient down.</h1>
      <div class="mt-8"><MarketingDemo /></div>
    </Section>
  </main>
</BaseLayout>
