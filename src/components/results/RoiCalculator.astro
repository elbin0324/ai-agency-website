---
// OWNER: results (calculator)
// Value calculator (DESIGN.md §6.22; founder decisions 2026-10-14): an ivory worksheet on the navy desk
// and a navy readout that computeLevers() (@/data/roi) recalculates on every change. Every figure is a
// range from the base rates in content/BENCHMARKS.md to the optimistic ones, in profit terms only.
//   variant 'full'     /results/: five levers as an accordion (Lever.astro): a checkbox to count each
//                      one, its inputs, its own range and "See the math". A sticky readout with the
//                      combined range, added revenue as context, hours back and the breakdown chart
//                      (Breakdown.astro: its legend keys toggle levers too, with tooltips), then the
//                      brass CTA. Reads ?team=…&levers=…&open=… from the URL, so numbers carried over
//                      from the home calculator are restored.
//   Both variants, under 1024px: a dock rides the bottom of the screen while the inputs are in view
//                      (labeled Modeled estimate: the total and the hours back a month), so the figure
//                      being changed stays on screen; it jumps to the readout and scrolls away with the
//                      worksheet.
//   variant 'compact'  Home: team time plus customer inquiries, four inputs, the range, one row per
//                      lever, two math lines, links that open each of the other three levers on
//                      /results/, and "Open the full calculator" (all of them carry the numbers).
// Renders no <section>: the page supplies the navy band and id="calculator". Ids are prefixed with `id`
// and every instance runs its own script state, so two calculators can share a page.
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import IllustrativeLabel from '@/components/ui/IllustrativeLabel.astro';
import { leverDisclaimer, leverFootnote } from '@/data/roi';
import { site } from '@/config/site';
import { url } from '@/lib/url';
import Breakdown from './calculator/Breakdown.astro';
import Field from './calculator/Field.astro';
import Lever from './calculator/Lever.astro';
import { compactLines, computeLevers, contactQuery, defaults, leverIds, leverInfo, rangeMoney, readout, type InputKey, type LeverId } from './calculator/view';

interface Props {
  variant?: 'full' | 'compact';
  /** Prefix for element ids (unique per page). */
  id?: string;
  class?: string;
}

const { variant = 'full', id = variant === 'full' ? 'roi' : 'roi-home', class: className } = Astro.props;
const full = variant === 'full';

const values = defaults();
const all = computeLevers(values);
const enabled: LeverId[] = full ? [...leverIds] : ['time', 'customers'];
const r = readout(all, enabled);
const lines = compactLines(all, values);
const contactBase = url('/contact/');
const resultsBase = url('/results/');
const compactGroups: { lever: LeverId; inputs: InputKey[] }[] = [
  { lever: 'time', inputs: ['teamSize', 'repetitiveHours'] },
  { lever: 'customers', inputs: ['monthlyInquiries', 'avgJobValue'] },
];
/** The levers the compact calculator leaves to /results/ (each links there, opened). */
const moreLevers = leverIds.filter((lv) => !compactGroups.some((g) => g.lever === lv));
/** "$12 million": the default revenue in the intro, from roi.ts. */
const revenueText = `$${(values.annualRevenue / 1e6).toLocaleString('en-US', { maximumFractionDigits: 1 })} million`;
const ctaHref = `${contactBase}${contactQuery(values, enabled, all)}`;
---
<div
  class:list={['vc', `vc--${variant}`, className]}
  id={id}
  data-vc
  data-variant={variant}
  data-levers={enabled.join(',')}
  data-contact={contactBase}
  data-results={resultsBase}
>
  <div class="calc-sheet vc__sheet">
    <!-- Worksheet: inputs -->
    <div class="calc-sheet__in vc__in" role="group" aria-labelledby={`${id}-in-title`}>
      <div class="vc__in-head">
        <p class="type-label" id={`${id}-in-title`}>Your numbers{full && <span class="vc__in-sub">, lever by lever</span>}</p>
        {full && (
          <button type="button" class="vc__reset" data-reset>
            <Icon name="rotate-ccw" size={14} /><span>Reset<span class="vc__reset-more"> to defaults</span></span>
          </button>
        )}
      </div>

      {full ? (
        <Fragment>
          <p class="vc__intro">
            The defaults describe a typical 50-person business with about {revenueText} in revenue, {values.teamSize} of
            them in desk or customer-facing roles. Tick the levers that fit your business and open any of them to put in
            your own numbers.
          </p>
          <div class="vc__list">
            <div class="vc__cols" aria-hidden="true"><span>Count</span><span>Lever</span><span>Base case to upside, a year</span></div>
            {all.levers.map((l, i) => <Lever lever={l} values={values} prefix={id} open={i === 0} />)}
          </div>
        </Fragment>
      ) : (
        compactGroups.map((g) => (
          <div class="vc__group" style={`--k: var(--viz-${leverInfo[g.lever].slot})`}>
            <p class="vc__group-t"><span class="vc__key" aria-hidden="true"></span>{leverInfo[g.lever].name}<span class="vc__group-svc">{leverInfo[g.lever].service}</span></p>
            {g.inputs.map((k) => <Field k={k} prefix={id} value={values[k]} showHelp={false} />)}
          </div>
        ))
      )}

      <a class="vc__dock ctx-dark" href={`#${id}-out`}>
        <span class="vc__dock-t">
          <span class="vc__dock-k">
            <span class="vc__dock-tag">Modeled estimate</span><span data-o="dock-hours-wrap" hidden={!r.hasHours}> · <span data-o="dock-hours">{r.hoursShort}</span></span>
          </span>
          <span class="vc__dock-v"><b data-o="dock-figure">{r.figure}</b> a year</span>
        </span>
        <span class="vc__dock-go"><span>{full ? 'Breakdown' : 'Details'}</span><Icon name="chevron-down" size={16} /></span>
      </a>
    </div>

    <!-- Readout: outputs (navy) -->
    <div class="calc-sheet__out ctx-dark vc__out" id={`${id}-out`} tabindex="-1">
      <div class="vc__out-inner">
        <div class="vc__out-head">
          {full ? (
            <span class="type-label">Value a year · <span data-o="count">{r.countText}</span></span>
          ) : (
            <span class="type-label">Team time and customers, a year</span>
          )}
          <IllustrativeLabel kind="Modeled estimate" />
        </div>
        <p class="calc-out__fig vc__fig">
          <span aria-hidden="true" data-o="figure">{r.figure}</span><span class="sr-only" data-o="figure-sr">{r.figureSr}</span>{full && <small aria-hidden="true">a year</small>}
        </p>
        <div class="calc-out__pair vc__pair">
          <div><b data-o="low">{r.low}</b><span>base case, at typical rates</span></div>
          <div><b data-o="high">{r.high}</b><span>upside, at optimistic rates</span></div>
        </div>

        {full ? (
          <Fragment>
            <dl class="vc__context">
              <div data-o="revenue-row" hidden={!r.hasRevenue}>
                <dt>Added revenue</dt>
                <dd><b data-o="revenue">{r.revenue} a year</b><span>context only: counted above at gross margin</span></dd>
              </div>
              <div data-o="hours-row" hidden={!r.hasHours}>
                <dt>Staff time back</dt>
                <dd><b data-o="hours">{r.hours}</b><span data-o="fte">{r.fte}</span></dd>
              </div>
              <div data-o="breakeven-row" hidden={r.count === 0}>
                <dt>Break-even budget</dt>
                <dd><b data-o="breakeven">{r.breakEven}</b><span>the most the agents could cost and still pay off</span></dd>
              </div>
            </dl>
            <div class="vc__chart">
              <Breakdown prefix={id} all={all} r={r} enabled={enabled} />
            </div>
            <div class="vc__cta">
              <Button variant="brass" href={ctaHref} icon="arrow-right" class="vc__cta-btn" data-o="cta">Get your real numbers</Button>
              <p class="vc__foot">{leverFootnote} A free assessment replaces these defaults with yours.</p>
            </div>
          </Fragment>
        ) : (
          <Fragment>
            <ul class="vc__rows" role="list">
              {compactGroups.map((g) => {
                const lever = all.levers.find((l) => l.id === g.lever)!;
                return (
                  <li style={`--k: var(--viz-${leverInfo[g.lever].slot})`}>
                    <span class="vc__key" aria-hidden="true"></span>
                    <span class="vc__rows-k">{leverInfo[g.lever].name}</span>
                    <b data-o={`row-${g.lever}`}>{rangeMoney(lever.value)}</b>
                  </li>
                );
              })}
            </ul>
            <div class="math vc__lines" data-o="lines">
              {lines.map((l) => <p>{l}</p>)}
            </div>
            <p class="vc__more">
              <Icon name="sliders-horizontal" size={14} />
              <span>
                Three more levers in the full calculator:{' '}
                {moreLevers.map((lv, i) => (
                  <Fragment>{i > 0 && (i === moreLevers.length - 1 ? ', and ' : ', ')}<a class="link vc__more-a" href={`${resultsBase}?open=${lv}#calculator`} data-more={lv}>{leverInfo[lv].name.toLowerCase()}</a></Fragment>
                ))}.
              </span>
            </p>
          </Fragment>
        )}
      </div>
    </div>
  </div>

  <div class="vc__below">
    {full ? (
      <p class="vc__disclaimer">
        {leverDisclaimer} <a class="link" href={url('/results/#methodology')}>Methodology and sources</a>
      </p>
    ) : (
      <Fragment>
        <Button variant="outline-dark" href="/results/#calculator" icon="sliders-horizontal" iconPosition="start" data-o="full-link">Open the full calculator</Button>
        <Button variant="brass" href={ctaHref} icon="arrow-right" class="vc__cta-btn" data-o="cta">Get your real numbers</Button>
      </Fragment>
    )}
  </div>

  <p class="sr-only" aria-live="polite" aria-atomic="true" data-o="live"></p>
  <noscript>
    <p class="vc__noscript">
      Turn on JavaScript to use the calculator, or email your numbers to <a class="link" href={`mailto:${site.email}`}>{site.email}</a> and we'll run them for you.
    </p>
  </noscript>
</div>

<style>
  .vc { display: grid; gap: 20px; }
  /* clip (not hidden) keeps the rounded corners without making the sheet a scroll container,
     so the readout can stay in view while the levers scroll. */
  .vc .calc-sheet { overflow: clip; }
  .vc--full .calc-sheet { grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); }
  .vc--compact .calc-sheet { grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr); }

  .vc__in-head { display: flex; justify-content: space-between; align-items: center; gap: 12px; min-height: 28px; }
  .vc__reset {
    display: inline-flex; flex: none; align-items: center; gap: 6px; min-height: 32px; margin: -6px -8px -6px 0; padding: 0 8px;
    border-radius: var(--radius-control); font-size: 0.8125rem; font-weight: 550; color: var(--fg-2); white-space: nowrap; transition: color 0.2s, background-color 0.2s;
  }
  .vc__reset:hover { color: var(--fg); background: var(--color-paper-sunken); }
  .vc__reset :global(.icon) { color: var(--accent-display); }
  .vc__intro { max-width: 62ch; margin-top: -4px; font-size: 0.875rem; line-height: 1.55; color: var(--fg-2); }

  .vc__list { display: grid; }
  .vc__cols {
    display: grid; grid-template-columns: 2.25rem minmax(0, 1fr) auto; gap: 16px; padding: 0 40px 8px 0;
    font-family: var(--font-mono); font-size: 0.75rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--fg-3);
  }
  .vc__cols > span:first-child { margin-right: -16px; }

  /* Mobile dock: a one-line total that rides the bottom of the screen while the levers are in view. */
  .vc__dock {
    position: sticky; bottom: 12px; z-index: var(--z-raised); display: none; align-items: center; gap: 4px 14px;
    margin: 4px -6px 0; padding: 10px 14px; border-radius: var(--radius-tile); background: var(--color-navy-800);
    box-shadow: 0 0 0 1px var(--color-rule-dark-strong), 0 14px 30px -12px rgb(7 17 29 / 0.55); color: var(--color-on);
  }
  .vc__dock-t { display: grid; flex: 1 1 auto; min-width: 0; gap: 1px; }
  .vc__dock-k { font-size: 0.75rem; line-height: 1.3; color: var(--color-on-3); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .vc__dock-k [hidden] { display: none; }
  .vc__dock-tag { font-family: var(--font-mono); font-weight: 500; letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-brass-300); }
  .vc__dock-v { font-size: 0.8125rem; line-height: 1.35; color: var(--color-on-2); white-space: nowrap; }
  .vc__dock-v b { font-size: 1rem; font-weight: 600; color: var(--color-on); font-variant-numeric: tabular-nums; }
  .vc__dock-go { display: inline-flex; align-items: center; gap: 2px; font-size: 0.8125rem; font-weight: 550; color: var(--color-on); }
  .vc__dock-go :global(.icon) { color: var(--color-brass-300); }

  /* Compact worksheet: two small groups, each named with its chart color. */
  .vc__group { display: grid; gap: 18px; }
  .vc__group + .vc__group { padding-top: 18px; border-top: 1px solid var(--line); }
  .vc__group-t { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 10px; font-size: 0.9375rem; font-weight: 600; color: var(--fg); }
  .vc__group-svc { font-size: 0.8125rem; font-weight: 400; color: var(--fg-3); }
  .vc__key { flex: none; align-self: center; width: 10px; height: 10px; border-radius: 2px; background: var(--k); }

  /* Readout */
  .vc__out { position: relative; }
  .vc__out:focus { outline: none; }
  .vc__out-inner { display: flex; flex-direction: column; }
  .vc__out-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 8px 12px; }
  .vc__fig { flex-wrap: wrap; row-gap: 4px; }
  .vc__fig small { min-width: 3em; }
  .vc--compact .vc__fig { font-size: var(--text-h1); }
  .vc__pair span { line-height: 1.4; }

  .vc__context { display: grid; gap: 10px; margin-top: 16px; padding-top: 14px; border-top: 1px solid var(--color-rule-dark-strong); }
  .vc__context > div { display: grid; grid-template-columns: 8.5rem minmax(0, 1fr); gap: 4px 14px; font-size: 0.875rem; line-height: 1.45; }
  .vc__context > div[hidden] { display: none; }
  .vc__context dt { color: var(--color-on-3); }
  .vc__context dd b { display: block; font-weight: 600; color: var(--color-on); font-variant-numeric: tabular-nums; }
  .vc__context dd span { display: block; margin-top: 1px; font-size: 0.8125rem; color: var(--color-on-3); }

  .vc__chart { margin-top: 18px; padding-top: 16px; border-top: 1px solid var(--color-rule-dark-strong); }

  .vc__cta { display: grid; justify-items: start; gap: 12px; margin-top: 20px; padding-top: 18px; border-top: 1px solid var(--color-rule-dark-strong); }
  .vc__foot { font-size: 0.8125rem; line-height: 1.5; color: var(--color-on-3); }

  .vc__rows { display: grid; margin-top: 18px; border-top: 1px solid var(--color-rule-dark-strong); }
  .vc__rows > li { display: grid; grid-template-columns: 10px minmax(0, 1fr) auto; align-items: center; gap: 10px; padding: 10px 0; border-bottom: 1px solid var(--color-rule-dark); font-size: 0.875rem; }
  .vc__rows-k { color: var(--color-on-2); }
  .vc__rows b { font-weight: 600; color: var(--color-on); font-variant-numeric: tabular-nums; white-space: nowrap; }
  .vc__lines { margin-top: 14px; }
  .vc__lines > p + p { margin-top: 6px; }
  .vc__more { display: flex; gap: 8px; margin-top: auto; padding-top: 16px; font-size: 0.8125rem; line-height: 1.5; color: var(--color-on-2); }
  .vc__more :global(.icon) { flex: none; margin-top: 2px; color: var(--color-brass-300); }
  .vc__more-a { color: var(--color-on); font-weight: 500; }
  .vc--compact .vc__out-inner { flex: 1 1 auto; }

  /* Under the sheet: the disclaimer (full) or the two actions (compact). */
  .vc__below { display: flex; flex-wrap: wrap; align-items: center; justify-content: flex-end; gap: 16px 24px; }
  .vc--full .vc__below { justify-content: flex-start; }
  .vc__disclaimer { max-width: 80ch; font-size: 0.8125rem; line-height: 1.6; color: var(--fg-3); }
  .vc__disclaimer .link { color: var(--fg-2); white-space: nowrap; }
  .vc__noscript { font-size: 0.875rem; color: var(--fg-2); }

  /* Desktop: the readout stays in view while the levers scroll (only when it fits the screen). */
  @media (width >= 64rem) and (height >= 46rem) {
    .vc--full .vc__out-inner { position: sticky; top: calc(var(--header-h) + 24px); }
  }
  @media (width < 64rem) {
    .vc .calc-sheet, .vc--full .calc-sheet, .vc--compact .calc-sheet { grid-template-columns: minmax(0, 1fr); }
    .vc .vc__dock { display: flex; min-height: 56px; }
  }
  @media (width < 40rem) {
    .vc__fig, .vc--compact .vc__fig { font-size: var(--text-h1); }
    .vc__cols { padding-right: 0; }
    .vc__in-sub, .vc__reset-more { display: none; }
    .vc__cols > span:last-child { display: none; }
    .vc__context > div { grid-template-columns: minmax(0, 1fr); }
    .vc__dock { margin: 4px 0 0; padding: 10px 12px; }
    .vc__dock-go span { display: none; }
    .vc__below { flex-direction: column-reverse; align-items: stretch; }
    .vc__below :global(.btn) { width: 100%; }
    .vc :global(.vc__cta-btn) { width: 100%; height: auto; min-height: 52px; padding-block: 12px; white-space: normal; text-align: center; line-height: 1.3; }
    .vc__cta { justify-items: stretch; }
  }
  @media (pointer: coarse) {
    .vc__reset, .vc :global(.vb__toggle) { position: relative; }
    .vc__reset::after, .vc :global(.vb__toggle)::after { content: ""; position: absolute; inset: -6px 0; }
  }
</style>

<script>
  import { initCalculator } from './calculator/client';
  document.querySelectorAll<HTMLElement>('[data-vc]').forEach(initCalculator);
</script>
