---
// OWNER: results
// Savings calculator (DESIGN.md §6.22): an ivory worksheet of sliders paired with number fields on the
// navy desk, and a navy readout that computeRoi() (@/data/roi) recalculates on every change.
//   variant 'full'     /results/: help text under every input, Reset, "Where the hours come from" chart
//                      with its table twin, the formula ledger and the full disclaimer. Reads ?team=…
//                      from the URL so numbers carried over from the home calculator are restored.
//   variant 'compact'  Home: the same five inputs and outputs, help text kept for screen readers only,
//                      a two-line formula and "Open the full calculator" (which carries the numbers).
// Renders no <section>: the page supplies the navy band and id="calculator". Every instance runs its
// own script state, and ids are prefixed with `id`, so two calculators can share a page.
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import IllustrativeLabel from '@/components/ui/IllustrativeLabel.astro';
import { roiInputs, roiDisclaimer, computeRoi } from '@/data/roi';
import { site } from '@/config/site';
import { url } from '@/lib/url';
import { buildView, contactQuery, defaultValues, fieldMeta, notchesFor, stopIndex, valueText, K } from './roi-view';

interface Props {
  variant?: 'full' | 'compact';
  /** Prefix for element ids (unique per page). */
  id?: string;
  class?: string;
}

const { variant = 'full', id = variant === 'full' ? 'roi' : 'roi-home', class: className } = Astro.props;
const full = variant === 'full';

const values = defaultValues();
const result = computeRoi(values);
const view = buildView(values, result);
const contactBase = url('/contact/');
const resultsBase = url('/results/');

const fields = roiInputs.map((spec) => {
  const stops = notchesFor(spec);
  const pos = stopIndex(stops, spec.default);
  return {
    spec,
    meta: fieldMeta[spec.id] ?? { many: '' , short: spec.label },
    stops,
    pos,
    fill: (pos / (stops.length - 1)) * 100,
    labelId: `${id}-${spec.id}-label`,
    numId: `${id}-${spec.id}`,
    helpId: `${id}-${spec.id}-help`,
    errId: `${id}-${spec.id}-error`,
  };
});
const chartTitleId = `${id}-chart-title`;
const keys = `${100 - K.review}% is what's left after ${K.review}% is set aside for human review · ${K.weeks} working weeks a year · ${K.minutes} staff minutes per inquiry, ${K.resolved}% resolved without staff · ${K.fteHours.toLocaleString('en-US')} hours a full-time person works in a year. Each line is rounded down.`;
---
<div
  class:list={['roi', `roi--${variant}`, className]}
  id={id}
  data-roi
  data-variant={variant}
  data-contact={contactBase}
  data-results={resultsBase}
>
  <div class="calc-sheet roi__sheet">
    <!-- Worksheet: inputs -->
    <div class="calc-sheet__in roi__in" role="group" aria-labelledby={`${id}-in-title`}>
      <div class="roi__in-head">
        <p class="type-label" id={`${id}-in-title`}>Your numbers</p>
        {full && (
          <button type="button" class="roi__reset" data-reset>
            <Icon name="rotate-ccw" size={14} /><span>Reset to defaults</span>
          </button>
        )}
      </div>

      {fields.map((f) => (
        <div class="calc-field roi-field" data-field={f.spec.id} data-stops={JSON.stringify(f.stops)}>
          <div class="calc-field__top roi-field__top">
            <label for={f.numId} id={f.labelId}>{f.spec.label}</label>
            <span class="roi-num">
              {f.meta.prefix && <span class="roi-num__fix" aria-hidden="true">{f.meta.prefix}</span>}
              <input
                class="roi-num__input"
                id={f.numId}
                type="number"
                inputmode="numeric"
                min={f.spec.min}
                max={f.spec.max}
                step={f.spec.step}
                value={f.spec.default}
                aria-describedby={`${f.helpId} ${f.errId}`}
                data-num
              />
              {f.meta.suffix && <span class="roi-num__fix" aria-hidden="true">{f.meta.suffix}</span>}
            </span>
          </div>
          <input
            class="range"
            type="range"
            min="0"
            max={f.stops.length - 1}
            step="1"
            value={f.pos}
            aria-labelledby={f.labelId}
            aria-describedby={f.helpId}
            aria-valuetext={valueText(f.spec.id, f.spec.default)}
            style={`--fill: ${f.fill}%`}
            data-range
          />
          <p class:list={['field__hint roi-field__help', !full && 'sr-only']} id={f.helpId}>{f.spec.help}</p>
          <p class="field__error roi-field__error" id={f.errId} hidden data-error>
            <Icon name="circle-alert" size={14} /><span>Enter a number between {f.spec.min.toLocaleString('en-US')} and {f.spec.max.toLocaleString('en-US')}.</span>
          </p>
        </div>
      ))}
    </div>

    <!-- Readout: outputs (navy) -->
    <div class="calc-sheet__out ctx-dark roi__out">
      <div class="roi__out-head">
        <span class="type-label">Hours back each month</span>
        <IllustrativeLabel kind="Modeled estimate" />
      </div>
      <p class="calc-out__fig roi__fig"><span data-o="hours">{view.hours}</span><small data-o="hours-unit">{view.hoursUnit}</small></p>
      <div class="calc-out__pair">
        <div><b data-o="annual">{view.annual}</b><span>value of that time each year</span></div>
        <div><b data-o="monthly">{view.monthly}</b><span>break-even budget a month</span></div>
      </div>
      {full && (
        <p class="roi__be">Break-even budget: the most an AI program could cost each month and still pay for itself in time saved.</p>
      )}
      <p class="calc-out__fte">Capacity added: <b><span data-o="fte">{view.fte}</span> full-time staff</b>, without a new hire.</p>

      <figure class="chart roi-chart" aria-labelledby={chartTitleId} data-chart>
        <div class="chart__head">
          <div>
            <p class="chart__title" id={chartTitleId}>Where the hours come from</p>
            {full && <p class="chart__sub">Hours back a month, by source</p>}
          </div>
          {full && (
            <button type="button" class="chart__toggle roi-chart__toggle" aria-pressed="false" data-chart-toggle>
              <Icon name="list" size={14} /><span data-chart-toggle-label>Show table</span>
            </button>
          )}
        </div>
        <div class="chart__plot">
          <ul class="hbars roi-bars" role="list">
            {view.rows.map((row) => (
              <li class="hbar" data-row={row.id}>
                <span class="hbar__label">{row.label}</span>
                <span class="hbar__track" aria-hidden="true"><span class="hbar__fill" style={`--v: ${row.pct}%`}></span></span>
                <span class="hbar__val" data-o="row-hours">{row.hoursText}</span>
              </li>
            ))}
          </ul>
        </div>
        {full && (
          <div class="chart__table">
            <table class="chart-table">
              <caption class="sr-only">Hours back a month and their value a year, by source</caption>
              <thead><tr><th scope="col">Source</th><th scope="col">Hours a month</th><th scope="col">Value a year</th></tr></thead>
              <tbody>
                {view.rows.map((row) => (
                  <tr data-row={row.id}><th scope="row">{row.label}</th><td data-o="row-hours">{row.hoursText}</td><td data-o="row-annual">{row.annualText}</td></tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </figure>

      {full && (
        <p class="roi-check" data-o="check" data-state={view.withinCeiling ? 'ok' : 'over'}>
          <span class="roi-check__ok"><Icon name="circle-check" size={16} /></span>
          <span class="roi-check__over"><Icon name="info" size={16} /></span>
          <span>
            Per person: <b data-o="per-person">{view.perPerson}</b> of desk work handed to agents.{' '}<span class="roi-check__ok">Within the {K.ceiling} hours a week the research supports for routine admin work.</span><span class="roi-check__over">That's above the {K.ceiling} hours a week the research supports for routine admin work, so treat it as an upper bound.</span>
          </span>
        </p>
      )}

      {full ? (
        <div class="roi__math">
          <table class="roi-ledger">
            <caption class="sr-only">The math behind the estimate</caption>
            <tbody data-o="ledger">
              {view.ledger.map(([label, formula, value]) => (
                <tr><th scope="row">{label}</th><td class="roi-ledger__f" set:html={formula} /><td class="roi-ledger__v" set:html={value} /></tr>
              ))}
            </tbody>
          </table>
          <p class="roi__keys">{keys}</p>
        </div>
      ) : (
        <div class="roi__math math" data-o="lines">
          {view.lines.map((l) => <p set:html={l} />)}
        </div>
      )}
    </div>
  </div>

  <div class="roi__foot">
    {full ? (
      <p class="roi__disclaimer">
        {roiDisclaimer} <a class="link" href={url('/results/#methodology')}>Methodology and sources</a>
      </p>
    ) : (
      <Button variant="outline-dark" href="/results/#calculator" icon="sliders-horizontal" iconPosition="start" data-o="full-link">Open the full calculator</Button>
    )}
    <Button variant="brass" href={`${contactBase}${contactQuery(values, result)}`} icon="arrow-right" class="roi__cta" data-o="cta">
      Get your real numbers
    </Button>
  </div>

  <p class="sr-only" aria-live="polite" aria-atomic="true" data-o="live"></p>
  <noscript>
    <p class="roi__noscript">
      Turn on JavaScript to use the calculator, or email your numbers to <a class="link" href={`mailto:${site.email}`}>{site.email}</a> and we'll run them for you.
    </p>
  </noscript>
</div>

<style>
  .roi { display: grid; gap: 20px; }
  .roi__in-head { display: flex; justify-content: space-between; align-items: center; gap: 12px; min-height: 28px; }
  .roi__reset {
    display: inline-flex; align-items: center; gap: 6px; min-height: 32px; margin: -6px -8px -6px 0; padding: 0 8px;
    border-radius: var(--radius-control); font-size: 0.8125rem; font-weight: 550; color: var(--fg-2); transition: color 0.2s, background-color 0.2s;
  }
  .roi__reset:hover { color: var(--fg); background: var(--color-paper-sunken); }
  .roi__reset :global(.icon) { color: var(--accent-display); }

  /* One input: label + number field on one row, the slider under them, help and error below. */
  .roi-field__top { align-items: center; }
  .roi-field__top label { line-height: 1.4; }
  .roi-field .range { margin-top: 8px; }
  .roi-field__help { margin-top: 4px; max-width: 62ch; }
  .roi-field__error { margin-top: 6px; }
  .roi-field__error :global(.icon) { margin-top: 2px; }

  .roi-num {
    display: inline-flex; flex: none; align-items: center; gap: 4px; width: 7.5rem; height: 44px; padding: 0 12px;
    border: 1px solid var(--color-field); border-radius: var(--radius-control); background: var(--color-paper-raised);
    font-size: 1rem; color: var(--color-ink-3); cursor: text; transition: border-color 0.15s;
  }
  .roi-num:hover { border-color: var(--color-ink-2); }
  .roi-num:focus-within { outline: 2px solid var(--color-focus); outline-offset: 2px; border-color: var(--color-ink); }
  .roi-num:has([aria-invalid='true']) { border-color: var(--color-danger); box-shadow: inset 0 0 0 1px var(--color-danger); }
  .roi-num__fix { flex: none; font-size: 0.9375rem; font-weight: 500; }
  .roi-num__input {
    width: 100%; min-width: 0; height: 100%; padding: 0; border: 0; background: transparent; outline: none;
    font-family: var(--font-sans); font-size: 1rem; font-weight: 600; text-align: right; color: var(--color-ink);
    font-variant-numeric: tabular-nums; -moz-appearance: textfield; appearance: textfield;
  }
  .roi-num__input::-webkit-outer-spin-button, .roi-num__input::-webkit-inner-spin-button { margin: 0; -webkit-appearance: none; }

  /* Readout */
  .roi__out-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 8px 12px; }
  .roi__fig small { min-width: 2.2em; }
  .roi__be { margin-top: 12px; font-size: 0.8125rem; line-height: 1.5; color: var(--color-on-3); }
  .roi .calc-out__fte { margin-top: 18px; padding-top: 16px; border-top: 1px solid var(--color-rule-dark-strong); font-size: 0.875rem; color: var(--color-on-2); }
  .roi .calc-out__fte b { color: var(--color-on); font-weight: 600; }

  .roi-chart { gap: 14px; margin-top: 18px; padding-top: 16px; border-top: 1px solid var(--color-rule-dark-strong); }
  .roi--compact .roi-chart { gap: 10px; }
  .roi-chart .chart__title { font-size: 0.875rem; }
  .roi-chart__toggle { min-height: 32px; }
  .roi-chart__toggle :global(.icon) { color: var(--accent-display); }
  .roi-bars { gap: 10px; }
  .roi-bars .hbar { grid-template-columns: 8.5rem minmax(0, 1fr) 3.5rem; }
  .roi-bars .hbar__fill { min-width: 2px; background: var(--viz-1); transition: width 0.35s var(--ease-out-soft); }
  .roi-chart .chart-table th[scope='row'] { font-weight: 400; color: var(--fg-2); }

  .roi-check { display: grid; grid-template-columns: 16px minmax(0, 1fr); gap: 10px; margin-top: 18px; padding: 12px 14px; border-radius: var(--radius-tile); background: var(--color-navy-800); box-shadow: inset 0 0 0 1px var(--color-rule-dark); font-size: 0.8125rem; line-height: 1.5; color: var(--color-on-2); }
  .roi-check b { font-weight: 600; color: var(--color-on); }
  .roi-check :global(.icon) { margin-top: 2px; }
  .roi-check__ok :global(.icon) { color: var(--color-sage); }
  .roi-check__over :global(.icon) { color: var(--color-on-2); }
  .roi-check[data-state='ok'] .roi-check__over, .roi-check[data-state='over'] .roi-check__ok { display: none; }
  .roi__math { margin-top: auto; padding-top: 18px; }
  .roi--compact .roi__math > p + p { margin-top: 2px; }
  .roi-ledger { width: 100%; border-collapse: collapse; font-size: 0.8125rem; line-height: 1.45; }
  .roi-ledger th, .roi-ledger td { padding: 8px 0; text-align: left; vertical-align: baseline; border-bottom: 1px solid var(--color-rule-dark); }
  .roi-ledger tr:first-child > * { border-top: 1px solid var(--color-rule-dark-strong); }
  .roi-ledger th { padding-right: 14px; font-weight: 500; color: var(--color-on-2); white-space: nowrap; }
  .roi-ledger__f { padding-right: 14px; font-family: var(--font-mono); letter-spacing: 0.01em; color: var(--color-on-3); font-variant-numeric: tabular-nums; }
  .roi-ledger .roi-ledger__v { text-align: right; white-space: nowrap; font-variant-numeric: tabular-nums; color: var(--color-on-3); }
  .roi-ledger :global(b) { font-weight: 600; color: var(--color-on); }
  .roi__keys { margin-top: 12px; font-size: 0.75rem; line-height: 1.55; color: var(--color-on-3); }

  /* Under the sheet: disclaimer (full) or the second action (compact), then the one brass CTA. */
  .roi__foot { display: flex; flex-wrap: wrap; align-items: center; justify-content: flex-end; gap: 16px 24px; }
  .roi--full .roi__foot { justify-content: space-between; align-items: flex-start; }
  .roi__disclaimer { flex: 1 1 32rem; max-width: 72ch; font-size: 0.8125rem; line-height: 1.6; color: var(--fg-3); }
  .roi__disclaimer .link { color: var(--fg-2); white-space: nowrap; }
  .roi__noscript { font-size: 0.875rem; color: var(--fg-2); }

  @media (width < 64rem) {
    .roi--full .roi__foot { flex-direction: column-reverse; align-items: stretch; }
    .roi--full .roi__foot :global(.roi__cta) { align-self: flex-start; }
    /* In the column the 32rem basis would become a 512px height: size the disclaimer to its text.
       The 72ch measure stays, so tablet lines don't run 120+ characters. */
    .roi--full .roi__disclaimer { flex: none; }
  }
  @media (width < 40rem) {
    .roi-field__top label { flex: 1 1 auto; min-width: 0; }
    .roi-num { width: 6.5rem; padding: 0 10px; }
    .roi-bars .hbar { grid-template-columns: 7.5rem minmax(0, 1fr) 3.25rem; }
    .roi-ledger, .roi-ledger tbody, .roi-ledger tr { display: block; }
    .roi-ledger tr { display: grid; grid-template-columns: minmax(0, 1fr) auto; column-gap: 12px; padding: 8px 0; border-bottom: 1px solid var(--color-rule-dark); }
    .roi-ledger tr:first-child { border-top: 1px solid var(--color-rule-dark-strong); }
    .roi-ledger th, .roi-ledger td, .roi-ledger tr:first-child > * { padding: 0; border: 0; }
    .roi-ledger__f { grid-column: 1 / -1; grid-row: 2; padding-top: 2px; }
    .roi__foot { flex-direction: column-reverse; align-items: stretch; }
    .roi__foot :global(.btn) { width: 100%; }
    .roi__foot :global(.roi__cta) { height: auto; min-height: 52px; padding-block: 12px; white-space: normal; text-align: center; line-height: 1.3; }
    .roi--full .roi__foot :global(.roi__cta) { align-self: stretch; }
  }
  /* Touch screens: 44px tap targets. The two small buttons keep their look and get an invisible
     44px hit area; the slider thumbs grow from 20px to 28px (the size of iOS's own) to grab and drag. */
  @media (pointer: coarse) {
    .roi__reset, .roi-chart__toggle { position: relative; }
    .roi__reset::after, .roi-chart__toggle::after { content: ""; position: absolute; inset: -6px 0; }
    .roi-field .range { height: 32px; }
    .roi-field .range::-webkit-slider-thumb { width: 28px; height: 28px; margin-top: -12px; }
    .roi-field .range::-moz-range-thumb { width: 26px; height: 26px; }
  }
</style>

<script>
  import { computeRoi, roiInputs } from '@/data/roi';
  import { buildView, carryQuery, contactQuery, defaultValues, paramNames, sanitizeValue, stopIndex, valueText, type RoiValues } from './roi-view';

  type Field = {
    id: string;
    spec: (typeof roiInputs)[number];
    num: HTMLInputElement;
    range: HTMLInputElement;
    error: HTMLElement;
    stops: number[];
  };

  function init(root: HTMLElement) {
    if (root.dataset.ready === 'true') return;
    root.dataset.ready = 'true';
    const full = root.dataset.variant === 'full';
    const contactBase = root.dataset.contact ?? '/contact/';
    const resultsBase = root.dataset.results ?? '/results/';
    const values: RoiValues = defaultValues();
    const out = (k: string) => root.querySelector<HTMLElement>(`[data-o="${k}"]`);

    const fields: Field[] = roiInputs.flatMap((spec) => {
      const el = root.querySelector<HTMLElement>(`[data-field="${spec.id}"]`);
      const num = el?.querySelector<HTMLInputElement>('[data-num]');
      const range = el?.querySelector<HTMLInputElement>('[data-range]');
      const error = el?.querySelector<HTMLElement>('[data-error]');
      if (!el || !num || !range || !error) return [];
      let stops: number[] = [];
      try { stops = JSON.parse(el.dataset.stops ?? '[]'); } catch { /* fall back below */ }
      if (!stops.length) stops = [spec.min, spec.max];
      return [{ id: spec.id, spec, num, range, error, stops }];
    });

    const showError = (f: Field, on: boolean) => {
      f.error.hidden = !on;
      if (on) f.num.setAttribute('aria-invalid', 'true');
      else f.num.removeAttribute('aria-invalid');
    };

    const paintRange = (f: Field) => {
      const pos = stopIndex(f.stops, values[f.id]);
      f.range.value = String(pos);
      f.range.style.setProperty('--fill', `${(pos / Math.max(f.stops.length - 1, 1)) * 100}%`);
      f.range.setAttribute('aria-valuetext', valueText(f.id, values[f.id]));
    };

    let liveTimer = 0;
    const render = () => {
      const r = computeRoi(values);
      const v = buildView(values, r);
      const set = (k: string, text: string) => { const el = out(k); if (el && el.textContent !== text) el.textContent = text; };
      set('hours', v.hours);
      set('hours-unit', v.hoursUnit);
      set('annual', v.annual);
      set('monthly', v.monthly);
      set('fte', v.fte);
      v.rows.forEach((row) => {
        root.querySelectorAll<HTMLElement>(`[data-row="${row.id}"]`).forEach((rowEl) => {
          const fill = rowEl.querySelector<HTMLElement>('.hbar__fill');
          if (fill) fill.style.setProperty('--v', `${row.pct}%`);
          rowEl.querySelectorAll<HTMLElement>('[data-o="row-hours"]').forEach((n) => { n.textContent = row.hoursText; });
          rowEl.querySelectorAll<HTMLElement>('[data-o="row-annual"]').forEach((n) => { n.textContent = row.annualText; });
        });
      });
      const check = out('check');
      if (check) check.dataset.state = v.withinCeiling ? 'ok' : 'over';
      set('per-person', v.perPerson);
      const ledger = out('ledger');
      if (ledger) {
        ledger.querySelectorAll('tr').forEach((tr, i) => {
          const row = v.ledger[i];
          if (!row) return;
          const cells = tr.querySelectorAll('td');
          if (cells[0]) cells[0].innerHTML = row[1];
          if (cells[1]) cells[1].innerHTML = row[2];
        });
      }
      const lines = out('lines');
      if (lines) lines.querySelectorAll('p').forEach((p, i) => { if (v.lines[i]) p.innerHTML = v.lines[i]; });
      const cta = out('cta') as HTMLAnchorElement | null;
      if (cta) cta.href = `${contactBase}${contactQuery(values, r)}`;
      const carry = out('full-link') as HTMLAnchorElement | null;
      if (carry) carry.href = `${resultsBase}${carryQuery(values)}#calculator`;
      window.clearTimeout(liveTimer);
      liveTimer = window.setTimeout(() => { const live = out('live'); if (live) live.textContent = v.live; }, 700);
    };

    const commit = (f: Field, raw: number, from: 'num' | 'range' | 'set') => {
      values[f.id] = sanitizeValue(f.spec, raw);
      if (from !== 'num') f.num.value = String(values[f.id]);
      paintRange(f);
      showError(f, false);
      render();
    };

    fields.forEach((f) => {
      f.range.addEventListener('input', () => commit(f, f.stops[Number(f.range.value)] ?? f.spec.default, 'range'));
      f.num.addEventListener('input', () => {
        const raw = f.num.value.trim();
        const n = Number(raw);
        if (raw === '' || !Number.isFinite(n) || n < f.spec.min || n > f.spec.max) { showError(f, raw !== ''); return; }
        commit(f, n, 'num');
      });
      f.num.addEventListener('change', () => {
        const n = Number(f.num.value.trim());
        commit(f, f.num.value.trim() === '' || !Number.isFinite(n) ? values[f.id] : n, 'set');
      });
    });

    root.querySelector('[data-reset]')?.addEventListener('click', () => {
      const d = defaultValues();
      fields.forEach((f) => { values[f.id] = d[f.id]; f.num.value = String(d[f.id]); paintRange(f); showError(f, false); });
      render();
    });

    const toggle = root.querySelector<HTMLButtonElement>('[data-chart-toggle]');
    const chart = root.querySelector<HTMLElement>('[data-chart]');
    toggle?.addEventListener('click', () => {
      const table = chart?.dataset.view !== 'table';
      if (chart) chart.dataset.view = table ? 'table' : 'chart';
      toggle.setAttribute('aria-pressed', String(table));
      const label = toggle.querySelector('[data-chart-toggle-label]');
      if (label) label.textContent = table ? 'Show chart' : 'Show table';
    });

    // Numbers carried over from the home calculator (?team=…&hourly=…).
    if (full) {
      const params = new URLSearchParams(window.location.search);
      fields.forEach((f) => {
        const raw = params.get(paramNames[f.id]);
        if (raw !== null && raw.trim() !== '' && Number.isFinite(Number(raw))) {
          values[f.id] = sanitizeValue(f.spec, Number(raw));
          f.num.value = String(values[f.id]);
        }
      });
    }
    fields.forEach(paintRange);
    render();
  }

  document.querySelectorAll<HTMLElement>('[data-roi]').forEach(init);
</script>
