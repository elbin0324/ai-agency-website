---
// OWNER: pages-misc
// The free-assessment intake (DECISIONS.md 2026-10-14: "The free assessment asks real questions").
// Five short steps a senior consultant would ask before a first call, so the call starts with a draft
// estimate: 1 your business · 2 where the hours go · 3 customers and growth · 4 priorities · 5 contact.
// Questions and options live in ./intake.ts; the live estimate panel (./EstimatePanel.astro) sits beside
// the form on the page and is filled by ./intake-client.ts through ./estimate.ts (computeLevers).
//
// Without JS: one long form (all five steps stacked), native validation, then a POST to
//   site.formEndpoint when set, else a mailto: to site.email. While there is neither (site.email is the
//   placeholder), a note says the form isn't connected yet and the submit stays disabled.
// With JS (intake-client.ts): one step at a time with a progress rail, Back / Next, inline accessible
//   validation (first problem focused and scrolled clear of the sticky header), the live estimate (the
//   panel beside the form, plus a sticky estimate bar on phones and tablets), a draft kept in
//   sessionStorage for this tab, calculator prefill from /contact/?source=calculator&…, the link context
//   from contactUrl() (?interest= ticks a priority, ?plan= and ?from= go into the summary), then
//   Formspree-style JSON (endpoint set) or a pre-written email (real site.email) carrying a readable
//   summary of every answer, or the "not connected yet" note while site.email is the placeholder.
import Icon from '@/components/ui/Icon.astro';
import Button from '@/components/ui/Button.astro';
import Callout from '@/components/blocks/Callout.astro';
import ChoiceGroup from './ChoiceGroup.astro';
import Field from './Field.astro';
import { site, emailReady } from '@/config/site';
import { url } from '@/lib/url';
import {
  steps, industries, teamSizes, revenues, locations, workTypes, hoursOptions, hourlyOptions, afterHoursOptions,
  adSpendOptions, outboundOptions, goals, tools, timelines, deciders, contactPrefs, MAX_GOALS, NOT_SURE,
} from './intake';

const endpoint = site.formEndpoint;
/** Somewhere to send: a form endpoint, or a real (non-placeholder) inbox for the mailto fallback. */
const connected = !!endpoint || emailReady;
const subject = 'Free AI assessment request';
const action = endpoint ?? `mailto:${site.email}?subject=${encodeURIComponent(subject)}`;
const methodUrl = new URL('results/#methodology', site.siteUrl).toString();
const id = (s: string) => `cf-${s}`;
const total = steps.length;
const pad = (n: number) => String(n).padStart(2, '0');
---
<div class="cform card" data-contact-form-root>
  <div class="cform__panel" data-cf-panel>
    <div class="cform__head">
      <h2 class="type-h3" id="form-title">Tell us about your business.</h2>
      <p class="cform__intro">Five short steps, about 4 minutes. Rough answers are fine, and you can skip anything you’d rather cover on the call.</p>
    </div>

    <ol class="cprog" aria-label="Form progress" data-cf-progress>
      {steps.map((s, i) => (
        <li class:list={['cprog__item', i === 0 && 'is-current']} data-cf-prog={i}>
          <button type="button" class="cprog__btn" data-cf-goto={i} aria-current={i === 0 ? 'step' : undefined} disabled={i > 0}>
            <span class="cprog__knot" aria-hidden="true"></span>
            <span class="cprog__n" aria-hidden="true">{pad(i + 1)}</span>
            <span class="cprog__label"><span class="sr-only">Step {i + 1}: </span>{s.short}<span class="sr-only" data-cf-prog-state></span></span>
          </button>
        </li>
      ))}
    </ol>

    <a class="cpeek" href="#estimate" data-cf-peek hidden>
      <span class="cpeek__k">Modeled estimate</span>
      <span class="cpeek__go">Details<Icon name="chevron-down" /></span>
      <span class="cpeek__v"><b data-cf-peek-value></b> a year</span>
    </a>

    <div class="cform__calc" data-cf-calc hidden>
      <Callout variant="method" title="Your calculator answers are filled in." icon="calculator">
        Check them as you go and change anything that’s off. The estimate beside the form updates as you do.
      </Callout>
    </div>

    <div class="cform__restored" data-cf-restored hidden>
      <Callout variant="note" icon="rotate-ccw" title="Picked up where you left off.">
        Your answers are saved in this browser tab only. <button type="button" class="link cform__reset" data-cf-reset>Start over</button>
      </Callout>
    </div>

    <form
      class="cform__form"
      data-contact-form
      data-endpoint={endpoint ?? ''}
      data-email={site.email}
      data-email-ready={emailReady ? 'true' : 'false'}
      data-subject={subject}
      data-method-url={methodUrl}
      action={action}
      method="post"
      enctype={endpoint ? undefined : 'text/plain'}
      aria-labelledby="form-title"
    >
      {/* ---------- 1. Your business ---------- */}
      <section class="cstep is-current" data-cf-step="0" aria-labelledby={id('step-1')}>
        <header class="cstep__head">
          <p class="cstep__n">Step 1 of {total}<span class="cstep__left"> · {steps[0].left}</span></p>
          <h3 class="cstep__title" id={id('step-1')} tabindex="-1">{steps[0].title}</h3>
          <p class="cstep__lead">{steps[0].lead}</p>
          <p class="cstep__quick" data-cf-quick-wrap hidden>
            <Icon name="clock" />
            <span>Short on time? <button type="button" class="link cstep__quick-btn" data-cf-quick>Skip the questions and just send your details</button></span>
          </p>
        </header>
        <div class="cstep__grid">
          <Field id={id('company')} name="company" label="Company" autocomplete="organization" required
            validate="required" msg="Please enter your company name." />
          <Field id={id('website')} name="website" label="Website" optional inputmode="url" autocomplete="url"
            placeholder="yourcompany.com" validate="url" msg="Please enter a web address, like yourcompany.com, or leave it blank."
            hint="We’ll take a look before the call." />
          <Field id={id('industry')} name="industry" label="Industry" as="select" options={industries} required
            validate="required" msg="Please choose the closest industry, or Other." />
          <Field id={id('team')} name="team_size" label="Team size" as="select" options={teamSizes} required
            validate="required" msg="Please choose a team size." summary="Team size (office and customer-facing)"
            hint="Office, admin, sales and customer-facing staff. Leave out mostly hands-on roles." attrs={{ 'data-cf-est': '' }} />
          <Field id={id('revenue')} name="revenue" label="Annual revenue" as="select" options={revenues} optional
            hint="Helps us size margin and pricing opportunities. Stays with us." attrs={{ 'data-cf-est': '' }} />
          <Field id={id('locations')} name="locations" label="Locations" as="select" options={locations} optional />
        </div>
      </section>

      {/* ---------- 2. Where the hours go ---------- */}
      <section class="cstep" data-cf-step="1" aria-labelledby={id('step-2')}>
        <header class="cstep__head">
          <p class="cstep__n">Step 2 of {total}<span class="cstep__left"> · {steps[1].left}</span></p>
          <h3 class="cstep__title" id={id('step-2')} tabindex="-1">{steps[1].title}</h3>
          <p class="cstep__lead" id={id('hours-lead')}>{steps[1].lead}</p>
        </header>

        <fieldset class="hours" aria-describedby={id('hours-lead')}>
          <legend class="sr-only">Hours a week on each kind of work, across your whole team</legend>
          <p class="hours__calc" data-cf-hours-calc hidden></p>
          <div class="hours__head" aria-hidden="true"><span>Kind of work</span><span>Hours a week, whole team</span></div>
          {workTypes.map((w) => (
            <div class="hours__row" data-cf-sum={w.label} data-cf-name={w.name}>
              <div class="hours__what">
                <label class="hours__label" for={id(w.name)}>{w.label}</label>
                <span class="hours__hint" id={id(`${w.name}-hint`)}>{w.hint}</span>
              </div>
              <select class="select hours__select" id={id(w.name)} name={w.name} aria-describedby={id(`${w.name}-hint`)} data-cf-est data-cf-hours>
                {hoursOptions.map((o) => <option value={o.label} selected={o.label === NOT_SURE}>{o.label}</option>)}
              </select>
            </div>
          ))}
          <p class="hours__total" data-cf-hours-total aria-live="polite">Pick a rough range for any you know. We’ll use typical hours for the rest.</p>
        </fieldset>

        <ChoiceGroup id={id('hourly')} name="hourly_cost" legend="Loaded hourly cost of the people doing this work"
          summary="Loaded hourly cost" options={hourlyOptions} checked={NOT_SURE} inputAttr="data-cf-est"
          hint="Pay plus payroll taxes and benefits. If you only know the wage, add about a third." />
      </section>

      {/* ---------- 3. Customers and growth ---------- */}
      <section class="cstep" data-cf-step="2" aria-labelledby={id('step-3')}>
        <header class="cstep__head">
          <p class="cstep__n">Step 3 of {total}<span class="cstep__left"> · {steps[2].left}</span></p>
          <h3 class="cstep__title" id={id('step-3')} tabindex="-1">{steps[2].title}</h3>
          <p class="cstep__lead">{steps[2].lead}</p>
        </header>
        <div class="cstep__grid">
          <Field id={id('inquiries')} name="inquiries" label="Customer inquiries a month" optional inputmode="numeric"
            placeholder="e.g. 400" validate="number" msg="Please enter one number, like 400, or leave it blank."
            hint="Calls, chats, emails, texts and web forms." attrs={{ 'data-cf-est': '', 'data-cf-format': 'count', autocomplete: 'off' }} />
          <Field id={id('job')} name="job_value" label="Average job or order value" optional inputmode="decimal" prefix="$"
            placeholder="e.g. 650" validate="number" msg="Please enter one dollar amount, like 650, or leave it blank."
            attrs={{ 'data-cf-est': '', 'data-cf-format': 'money', autocomplete: 'off' }} />
          <ChoiceGroup id={id('after')} name="after_hours" legend="Share of inquiries that arrive after hours"
            summary="Inquiries after hours" options={afterHoursOptions} checked={NOT_SURE} inputAttr="data-cf-est"
            class="cstep__wide" hint="Evenings, weekends and holidays." />
          <ChoiceGroup id={id('ads')} name="ad_spend" legend="Monthly ad spend" summary="Monthly ad spend"
            options={adSpendOptions} checked={NOT_SURE} inputAttr="data-cf-est" class="cstep__wide"
            hint="Google, Meta and any other paid channels, all together." />
          <ChoiceGroup id={id('outbound')} name="outbound" legend="Do you do outbound sales?" summary="Outbound sales"
            options={outboundOptions} inputAttr="data-cf-est" class="cstep__wide" optional
            hint="Reaching out to businesses or people who haven’t contacted you yet." />
          <div class="cstep__wide cstep__pair" data-cf-outbound-more>
            <Field id={id('prospects')} name="prospects" label="Prospects you could reach a month" optional inputmode="numeric"
              placeholder="e.g. 200" validate="number" msg="Please enter one number, like 200, or leave it blank."
              summary="Prospects a month" attrs={{ 'data-cf-est': '', 'data-cf-format': 'count', autocomplete: 'off' }} />
            <Field id={id('deal')} name="deal_value" label="Average deal value" optional inputmode="decimal" prefix="$"
              placeholder="e.g. 5,000" validate="number" msg="Please enter one dollar amount, like 5,000, or leave it blank."
              attrs={{ 'data-cf-est': '', 'data-cf-format': 'money', autocomplete: 'off' }} />
          </div>
        </div>
      </section>

      {/* ---------- 4. Priorities ---------- */}
      <section class="cstep" data-cf-step="3" aria-labelledby={id('step-4')}>
        <header class="cstep__head">
          <p class="cstep__n">Step 4 of {total}<span class="cstep__left"> · {steps[3].left}</span></p>
          <h3 class="cstep__title" id={id('step-4')} tabindex="-1">{steps[3].title}</h3>
          <p class="cstep__lead">{steps[3].lead}</p>
        </header>
        <div class="cstep__grid">
          <ChoiceGroup id={id('goals')} name="goals" type="checkbox" layout="tiles" legend="Your top goals"
            summary="Top goals" options={goals} hint={`Pick up to ${MAX_GOALS}.`} validate="goals" max={MAX_GOALS}
            msg={`Pick at least one goal, or choose “Not sure yet”.`} class="cstep__wide" />
          <Field id={id('first')} name="first_process" label="The one process you’d hand off first" optional
            placeholder="e.g. answering after-hours calls, or the weekly sales report" maxlength={200}
            summary="First process to hand off" class="cstep__wide" />
          <ChoiceGroup id={id('tools')} name="tools" type="checkbox" layout="chips" legend="Tools you use"
            summary="Tools" options={tools} optional hint="Pick any. It helps us come with specific ideas." class="cstep__wide" />
          <Field id={id('tools-other')} name="tools_other" label="Other tools" optional placeholder="e.g. ServiceTitan, Square, Zendesk"
            maxlength={200} class="cstep__wide" />
          <ChoiceGroup id={id('timeline')} name="timeline" legend="When would you like to start?" summary="Timeline"
            options={timelines} optional class="cstep__wide" />
          <ChoiceGroup id={id('deciders')} name="deciders" legend="Who else weighs in on the decision?" summary="Who else decides"
            options={deciders} optional class="cstep__wide" />
        </div>
      </section>

      {/* ---------- 5. Contact ---------- */}
      <section class="cstep" data-cf-step="4" aria-labelledby={id('step-5')}>
        <header class="cstep__head">
          <p class="cstep__n">Step 5 of {total}<span class="cstep__left"> · {steps[4].left}</span></p>
          <h3 class="cstep__title" id={id('step-5')} tabindex="-1">{steps[4].title}</h3>
          <p class="cstep__lead">{steps[4].lead}</p>
          <p class="cstep__quicknote" data-cf-quick-note hidden>
            <b>Just your name and email are needed.</b> We’ll cover the rest on the call.
            <button type="button" class="link" data-cf-unquick>Answer the questions instead</button>
          </p>
        </header>
        <div class="cstep__grid">
          <Field id={id('name')} name="name" label="Full name" autocomplete="name" required
            validate="required" msg="Please enter your name." />
          <Field id={id('email')} name="email" label="Work email" type="email" autocomplete="email" required
            placeholder="jordan@yourcompany.com" validate="email" msg="Please enter a valid email, like name@company.com."
            hint="We’ll send your assessment summary here. No newsletters." />
          <ChoiceGroup id={id('prefer')} name="preferred_contact" legend="How should we reach you?" summary="Preferred contact"
            options={contactPrefs} checked="Email" inputAttr="data-cf-contact" />
          <div class="cform__phone" data-cf-phone>
            <Field id={id('phone')} name="phone" label="Phone" type="tel" autocomplete="tel" inputmode="tel"
              validate="phone" msg="Please enter a phone number we can call, or choose email."
              hint="Only if you’d rather we call." attrs={{ 'data-cf-phone-input': '' }}>
              <span slot="label" class="optional" data-cf-phone-optional> (optional)</span>
            </Field>
          </div>
          <Field id={id('note')} name="note" label="Anything else we should know?" as="textarea" optional rows={4}
            maxlength={2000} placeholder="A sentence or two is plenty." summary="Note" class="cstep__wide" />
        </div>
      </section>

      {endpoint && (
        <Fragment>
          <input type="hidden" name="_subject" value={subject} />
          <div class="cform__trap" aria-hidden="true">
            <label>Leave this empty <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" /></label>
          </div>
        </Fragment>
      )}
      <input type="hidden" name="source" value="Contact page" data-cf-source />
      {/* The engagement model picked on /approach/ (?plan=…), filled by intake-client.ts. */}
      <input type="hidden" name="plan" value="" data-cf-plan />

      {!connected && (
        <div class="cform__nojs-note">
          <Callout variant="note" title="Online requests open very soon.">
            This form isn’t connected to our inbox yet, so it can’t send. Please check back shortly.
          </Callout>
        </div>
      )}

      <div class="cform__actions" data-cf-actions>
        <Button variant="secondary" size="lg" icon="arrow-left" iconPosition="start" class="cform__back" data-cf-back hidden>Back</Button>
        {/* Steps 2 to 4 only, with JavaScript: move on without answering (step 4's goal stops being required). */}
        <button type="button" class="cform__skip" data-cf-skip hidden>Skip this step</button>
        <Button size="lg" icon="arrow-right" class="cform__next" data-cf-next>
          Next<span class="cform__next-to" data-cf-next-to>: {steps[1].title}</span>
        </Button>
        {/* Disabled only while there is nowhere to send and JavaScript is off; the script enables it and
            shows the "not connected yet" note instead. Phones get the shorter label so Back fits beside it. */}
        <Button type="submit" size="lg" icon="arrow-right" class="cform__btn" data-cf-submit disabled={!connected}>
          <span class="cform__lbl-long">Request my free assessment</span><span class="cform__lbl-short">Send my request</span>
        </Button>
        <p class="cform__privacy" data-cf-privacy>We use your details only to respond to your request and prepare for the call. We don’t sell or share them.</p>
      </div>

      <div class="cform__status" data-cf-status aria-live="polite">
        <div data-cf-mailto hidden>
          <Callout variant="note" icon="mail" title="Your email app should open with your answers.">
            Press send and we’ll reply within one business day. Nothing opened? Email us at <a href={`mailto:${site.email}`}>{site.email}</a>.
          </Callout>
        </div>
        <div data-cf-unconnected hidden>
          <Callout variant="note" title="Thanks. Online requests open very soon.">
            This form isn’t connected to our inbox yet, so nothing was sent. Your answers are kept in this tab, and you can
            <button type="button" class="link cform__copy" data-cf-copy>copy them</button> to send later.
            <span class="cform__copied" data-cf-copied hidden> Copied.</span>
          </Callout>
        </div>
      </div>
      <div data-cf-error hidden role="alert">
        <Callout variant="danger" icon="circle-alert">
          Something went wrong on our end. Please try again, or email us at <a href={`mailto:${site.email}`}>{site.email}</a>.
        </Callout>
      </div>
    </form>
  </div>

  <div class="cform__done" data-cf-done hidden tabindex="-1" role="status">
    <span class="cform__done-mark"><Icon name="check" size={22} /></span>
    <h2 class="type-h3 cform__done-title"><span data-cf-thanks>Thanks. We’ve got it.</span></h2>
    <p class="cform__done-lead">We’ll reply within one business day to find a time for your call, and we’ll bring a draft estimate built from your answers. Look for an email from {site.email}.</p>
    <Callout variant="tip" title="While you wait:" class="cform__done-tip">
      if you can, jot down one example of work that eats your team’s time: a report, a common customer question or an inbox you dread.
    </Callout>
    <p class="cform__done-more"><a class="link-arrow" href={url('/demos/')}><span>Watch the agents work</span><Icon name="arrow-right" /></a></p>
  </div>
</div>

<style>
  .cform { padding: clamp(22px, 3vw, 40px); }
  .cform__head { padding-bottom: 22px; border-bottom: 1px solid var(--line); }
  .cform__intro { margin-top: 8px; font-size: 0.9375rem; color: var(--fg-3); }
  .cform__calc, .cform__restored { margin-top: 22px; }
  .cform__form { margin-top: 8px; }
  .cform__reset, .cform__copy { padding: 0; border: 0; background: none; font: inherit; color: var(--color-ink); cursor: pointer; }

  /* ---- Progress rail: five knots on a brass line (DESIGN.md §7.5). JS only. ---- */
  .cprog { position: relative; display: none; grid-template-columns: repeat(5, minmax(0, 1fr)); margin: 22px 0 0; padding: 0; list-style: none; }
  :global(html.js) .cprog { display: grid; }
  .cprog::before, .cprog::after { content: ""; position: absolute; left: 10%; top: 20px; height: 1px; pointer-events: none; }
  .cprog::before { right: 10%; background: var(--line-strong); }
  .cprog::after { width: calc(80% * var(--p, 0)); height: 1.5px; margin-top: -0.25px; background: var(--color-brass-500); transition: width 0.45s var(--ease-out-soft); }
  .cprog__item { min-width: 0; }
  .cprog__btn {
    display: grid; justify-items: center; gap: 4px; width: 100%; min-height: 44px; padding: 14px 4px 4px; border: 0; border-radius: var(--radius-control);
    background: none; font: inherit; color: var(--fg-3); cursor: pointer;
  }
  .cprog__btn:disabled { cursor: default; }
  .cprog__knot {
    position: relative; z-index: 1; width: 13px; height: 13px; border-radius: 50%; background: var(--color-paper-raised);
    box-shadow: inset 0 0 0 1.5px var(--color-field), 0 0 0 4px var(--color-paper-raised); transition: background-color 0.3s, box-shadow 0.3s;
  }
  .cprog__n { margin-top: 6px; font-family: var(--font-mono); font-size: 0.75rem; line-height: 1.2; letter-spacing: 0.06em; }
  .cprog__label { font-size: 0.8125rem; font-weight: 500; line-height: 1.3; white-space: nowrap; }
  .cprog__item.is-done .cprog__knot { background: var(--color-brass-500); box-shadow: inset 0 0 0 1.5px var(--color-brass-500), 0 0 0 4px var(--color-paper-raised); }
  .cprog__item.is-done .cprog__btn { color: var(--fg-2); }
  .cprog__item.is-done .cprog__n, .cprog__item.is-current .cprog__n { color: var(--accent); }
  .cprog__item.is-current .cprog__knot { box-shadow: inset 0 0 0 1.5px var(--color-brass-600), 0 0 0 4px var(--color-paper-raised), 0 0 0 5.5px var(--color-brass-500); }
  .cprog__item.is-current .cprog__btn { color: var(--fg); }
  .cprog__item.is-current .cprog__label { font-weight: 600; }
  /* Skipped: a dashed knot, so it reads as open rather than done. */
  .cprog__item.is-skipped .cprog__knot { background: var(--color-paper-raised); box-shadow: inset 0 0 0 1.5px var(--color-brass-500), 0 0 0 4px var(--color-paper-raised); }
  .cprog__item.is-skipped .cprog__knot::after { content: ""; position: absolute; top: 5.75px; left: 3.5px; right: 3.5px; height: 1.5px; border-radius: 1px; background: var(--color-brass-600); }
  .cprog__item.is-skipped .cprog__btn { color: var(--fg-3); }
  .cprog__btn:not(:disabled):hover .cprog__label { text-decoration: underline; text-decoration-color: var(--accent-line); text-underline-offset: 3px; }

  /* ---- Estimate bar (phones and tablets, where the panel sits below the form): sticks under the header
     while the visitor answers, so every change to the estimate is visible. ---- */
  .cpeek {
    position: sticky; top: calc(var(--header-h) + 8px); z-index: var(--z-sticky);
    display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 2px 12px;
    margin-top: 18px; padding: 10px 14px; border-radius: var(--radius-tile);
    background: var(--color-paper-sunken); box-shadow: inset 2px 0 0 var(--color-brass-500), var(--shadow-card);
    color: var(--fg-2); text-decoration: none; font-size: 0.875rem;
  }
  .cpeek[hidden] { display: none; }
  .cpeek__k { font-family: var(--font-mono); font-size: 0.75rem; line-height: 1.3; letter-spacing: 0.1em; text-transform: uppercase; color: var(--accent); }
  .cpeek__v { grid-column: 1; font-size: 0.875rem; line-height: 1.35; }
  .cpeek__v b { font-size: 1rem; font-weight: 600; color: var(--fg); font-variant-numeric: tabular-nums; }
  .cpeek__go { grid-column: 2; grid-row: 1 / span 2; display: inline-flex; align-items: center; gap: 4px; min-height: 44px; font-weight: 550; color: var(--fg); }
  .cpeek__go :global(.icon) { width: 14px; height: 14px; color: var(--accent-display); }
  .cpeek:focus-visible { outline: 2px solid var(--color-focus); outline-offset: 2px; }
  @media (width >= 64rem) { .cpeek { display: none !important; } }
  /* Keep a field that takes focus clear of that bar, not only of the header. */
  @media (width < 64rem) {
    :global(html.js) .cform__form :global(:is(input, select, textarea)) { scroll-margin-top: 84px; }
  }

  /* ---- Steps ---- */
  .cstep { padding-top: 26px; }
  .cstep + .cstep { margin-top: 34px; border-top: 1px solid var(--line); }
  :global(html.js) .cstep + .cstep { margin-top: 0; border-top: 0; }
  :global(html.js) .cstep:not(.is-current) { display: none; }
