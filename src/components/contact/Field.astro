---
// OWNER: pages-misc
// One labeled control (DESIGN.md §6.13): label above (never a placeholder label), the control, an
// optional hint and a hidden error line that intake-client.ts fills (aria-invalid + aria-describedby).
// `as`: input (default), select or textarea. `prefix` puts a "$" inside the left edge of an input.
// `validate`: required | email | phone | url | number (empty passes unless required) — read by the script.
import Icon from '@/components/ui/Icon.astro';
import type { Option } from './intake';

interface Props {
  id: string;
  name: string;
  label: string;
  as?: 'input' | 'select' | 'textarea';
  type?: 'text' | 'email' | 'tel';
  options?: Option[];
  /** Select only: the placeholder first option ("Choose one"). */
  choose?: string;
  placeholder?: string;
  autocomplete?: string;
  inputmode?: 'text' | 'email' | 'tel' | 'url' | 'numeric' | 'decimal';
  required?: boolean;
  optional?: boolean;
  validate?: 'required' | 'email' | 'phone' | 'url' | 'number';
  msg?: string;
  hint?: string;
  prefix?: string;
  suffix?: string;
  rows?: number;
  maxlength?: number;
  /** Short label for the emailed summary (default: the label). */
  summary?: string;
  class?: string;
  /** Extra attributes for the control itself (data hooks). */
  attrs?: Record<string, string | boolean | undefined>;
}

const {
  id, name, label, as = 'input', type = 'text', options = [], choose = 'Choose one', placeholder, autocomplete,
  inputmode, required = false, optional = false, validate, msg, hint, prefix, suffix, rows = 4, maxlength,
  summary, class: className, attrs = {},
} = Astro.props;
const hintId = hint ? `${id}-hint` : undefined;
const common = {
  id, name, required, 'aria-describedby': hintId, 'data-cf-validate': validate, 'data-cf-msg': msg, ...attrs,
};
---
<div class:list={['field', className]} data-cf-sum={summary ?? label} data-cf-name={name}>
  <label class="field__label" for={id}>{label}{optional && <span class="optional"> (optional)</span>}<slot name="label" /></label>
  {as === 'select' ? (
    <select class="select" {...common}>
      <option value="" selected disabled={required}>{choose}</option>
      {options.map((o) => <option value={o.label}>{o.label}</option>)}
    </select>
  ) : as === 'textarea' ? (
    <textarea class="textarea" rows={rows} placeholder={placeholder} maxlength={maxlength} {...common}></textarea>
  ) : prefix || suffix ? (
    <div class:list={['fx', prefix && 'fx--pre', suffix && 'fx--suf']}>
      {prefix && <span class="fx__pre" aria-hidden="true">{prefix}</span>}
      <input class="input" type={type} placeholder={placeholder} autocomplete={autocomplete} inputmode={inputmode} maxlength={maxlength} {...common} />
      {suffix && <span class="fx__suf" aria-hidden="true">{suffix}</span>}
    </div>
  ) : (
    <input class="input" type={type} placeholder={placeholder} autocomplete={autocomplete} inputmode={inputmode} maxlength={maxlength} {...common} />
  )}
  {hint && <p class="field__hint" id={hintId}>{hint}</p>}
  <p class="field__error" id={`${id}-err`} hidden><Icon name="circle-alert" /><span></span></p>
</div>

<style>
  .fx { position: relative; }
  .fx__pre, .fx__suf {
    position: absolute; top: 0; bottom: 0; display: flex; align-items: center; pointer-events: none;
    font-size: 1rem; color: var(--color-ink-3);
  }
  .fx__pre { left: 14px; }
  .fx__suf { right: 14px; font-size: 0.875rem; }
  .fx--pre .input { padding-left: 30px; }
  .fx--suf .input { padding-right: 64px; }
</style>
