---
// OWNER: services-b
// The AI Consulting comparison (DESIGN.md §6.18 cost ledger + range bars; reference: design-lab/reference/consulting.html).
// Every figure comes from @/data/consulting. Critique pass 2026-10-14:
// - Rows run by relevance to a 20-100 person business: independent consultant, regional boutique, Big
//   Four, contingency. A category whose low end is off the cost axis (the global strategy firm, which
//   rarely serves this size) folds into one muted line at the end, so it can't read as an anchor. All
//   five categories stay (DECISIONS.md 2026-10-12).
// - Both figure columns are range charts on shared axes with ticks: cost $0 to $110K, time 0 to 32 weeks.
//   Our time bar is the one brass mark. No price bar for us while site.consultingPrice is null ("Fixed fee,
//   scoped after a free assessment"); the contingency firm shows "No upfront fee" instead of a bar.
// - Phones: the column heads become the axes over compact cards (name, cost bar, time bar), notes sit
//   behind "Details", our card comes first and is the only navy one.
// Rules (content/DECISIONS.md): categories not firms; same scope, never "same results"; GSA figures
// labeled as federal ceilings (in the method notes); the price range + priceComparison() appear when set.
import Icon from '@/components/ui/Icon.astro';
import IllustrativeLabel from '@/components/ui/IllustrativeLabel.astro';
import { providers, ours, scopeNote, footnote, priceComparison, type Provider } from '@/data/consulting';
import { getSource } from '@/data/benchmarks';
import { site } from '@/config/site';
import { currency } from '@/lib/format';

interface Props {
  class?: string;
}
const { class: className } = Astro.props;

const COST_MAX = 110_000;
const COST_TICKS = [25_000, 50_000, 75_000, 100_000];
const WEEKS_MAX = 32;
const WEEK_TICKS = [8, 16, 24, 32];
const MONTH_WEEKS = 52 / 12;
// Relevance to a 20-100 person business; any category not listed follows in data order.
const ORDER = ['independent', 'regional-boutique', 'big-four', 'contingency'];

const times = (s: string) => s.replace(/ x /g, ' × ');
const cap = (s: string) => (s ? s[0].toUpperCase() + s.slice(1) : s);
const pct = (v: number, max: number) => `${Math.max(0, Math.min(100, (v / max) * 100)).toFixed(1)}%`;
const k = (v: number) => `$${Math.round(v / 1000)}K`;
const costTicks = COST_TICKS.map((t) => pct(t, COST_MAX));
const weekTicks = WEEK_TICKS.map((t) => pct(t, WEEKS_MAX));
// Axis labels: every cost tick on wide screens, only the even ones on phones (minor labels would collide).
// The week axis labels every other tick at all widths, so "24" never runs into the end label "32 wk".
const axisLabel = (at: string, label: string, minor = false) => ({ at, label, minor, end: at === '100.0%' });
const costAxis = [axisLabel('0%', '$0'), ...COST_TICKS.map((t, i) => axisLabel(pct(t, COST_MAX), k(t), i % 2 === 0))];
const weekAxis = [
  axisLabel('0%', '0'),
  ...WEEK_TICKS.filter((_, i) => i % 2 === 1).map((t) => axisLabel(pct(t, WEEKS_MAX), t === WEEKS_MAX ? `${t} wk` : String(t))),
];

/** "$30,000 to $63,000 (blended $250 to $350/hr x 120 to 180 hours), if …" -> fig + method note. */
function costCell(p: Provider) {
  if (p.costLow > 0 && p.costHigh > 0) {
    const rest = p.cost.replace(/^Modeled estimate:\s*/i, '').replace(/^\$[\d,.]+[KM]?\s+to\s+\$[\d,.]+[KM]?\+?\s*/i, '');
    let note = rest;
    if (rest.startsWith('(')) {
      const close = rest.indexOf(')');
      const inner = rest.slice(1, close);
      const after = rest.slice(close + 1).trim();
      note = after.startsWith(',') ? `${inner}${after}` : after.replace(/^\.\s*/, '') ? `${inner}. ${after.replace(/^\.\s*/, '')}` : `${inner}.`;
    }
    return {
      fig: `${currency(p.costLow)} to ${currency(p.costHigh)}`,
      note: times(cap(note.trim())),
      bar: { from: pct(p.costLow, COST_MAX), to: pct(p.costHigh, COST_MAX), open: p.costHigh > COST_MAX },
    };
  }
  // No fixed price (contingency): "$0 upfront, then 30% to 50% of verified savings for …" -> "No upfront fee".
  if (/^\$0 upfront/i.test(p.rate)) {
    const then = p.rate.replace(/^\$0 upfront,\s*then\s*/i, '').replace(/\s*\([^)]*\)\.?$/, '');
    const basis = p.cost.replace(/^Depends on savings found:\s*/i, '');
    return { fig: 'No upfront fee', note: times(`Then ${then}: ${basis}`), bar: null };
  }
  return { fig: cap(p.rate.split(',')[0].trim()), note: times(p.cost), bar: null, na: 'No fixed price' };
}

/** "8 to 17 weeks (modeled; …)" -> fig, note, and a span in weeks. */
function timeCell(s: string) {
  const m = s.match(/(\d+(?:\.\d+)?)\s*to\s*(\d+(?:\.\d+)?)(\+)?\s*(weeks|months)/i);
  const paren = s.match(/\(([^)]*)\)/);
  const fig = s.replace(/\s*\([^)]*\)/, '').split(';')[0].trim();
  const note = paren ? cap(paren[1]) : s.includes(';') ? cap(s.split(';').slice(1).join(';').trim()) : '';
  if (!m) return { fig, note, bar: null };
  const w = /month/i.test(m[4]) ? MONTH_WEEKS : 1;
  return { fig, note, bar: { from: pct(+m[1] * w, WEEKS_MAX), to: pct(+m[2] * w, WEEKS_MAX) } };
}

const rank = (p: Provider) => (ORDER.includes(p.id) ? ORDER.indexOf(p.id) : ORDER.length);
const all = [...providers].sort((a, b) => rank(a) - rank(b)).map((p) => ({ p, cost: costCell(p), time: timeCell(p.time) }));
const rows = all.filter(({ p }) => !(p.costLow > COST_MAX));
// Off the chart: one muted line. Its access note leads ("Rarely works with 20-100 person businesses.").
const far = all.filter(({ p }) => p.costLow > COST_MAX).map((r) => ({ ...r, lead: r.p.access.split(/(?<=\.)\s/)[0] }));

// Our row. Time: "Typically 3 to 5 weeks from kickoff to readout" -> fig + note.
const [ourTimeFig, ourTimeRest = ''] = ours.time.split(/\s+from\s+/);
const ourTime = timeCell(ourTimeFig);
const ourTimeNote = `${cap(ourTimeRest)}. The analysis itself takes days.`;
// "AI does … before it reaches you. You get an executive summary, …": the table shows the deliverables.
const ourGet = ours.includes.split(/\.\s+(?=You get)/)[1] ?? ours.includes;
// The brief serves companies up to 500 staff; this table keeps the 20-100 person scope it was costed for.
// (Page copy; @/data/consulting `ours.access` still reads 20-100 and is not shown here.)
const ourAccess =
  'Built for 20 to 500 person businesses. This table uses a 20-100 person scope; larger companies get a larger scope (more entities, more locations), priced the same way: a fixed fee after the free assessment.';
const price = site.consultingPrice;
const comparison = priceComparison(price);
const fixedRows = providers.filter((p) => p.costLow > 0);
const lowest = fixedRows.reduce((a, b) => (b.costLow < a.costLow ? b : a));
const lowestCmp = comparison?.find((c) => c.id === lowest.id);
const difference = lowestCmp && lowestCmp.savingsLow > 0 ? lowestCmp.savingsLow : null;
const ourName = ours.category.replace('{brand}', site.name);

// Footnote: on phones the first two sentences (sources, how totals were modeled) stay in view and the rest
// (GSA ceilings, SBDCs) moves into the method notes, next to the rates it qualifies.
const fn = times(footnote);
const fnCut = fn.indexOf(' GSA schedule');
const fnLead = fnCut > 0 ? fn.slice(0, fnCut) : fn;
const fnRest = fnCut > 0 ? fn.slice(fnCut + 1) : '';

// Every source behind the table, for the method disclosure (firm names may appear in citations only).
const sourceIds = [...new Set(all.flatMap(({ p }) => p.sources))];
const sources = sourceIds.map((id) => getSource(id)).filter((s): s is NonNullable<typeof s> => !!s);
---
<div class:list={['cl', className]}>
  <table class="cost-ledger cl__table">
    <caption>
      <span class="type-label">Same scope of work: a diagnostic plus a prioritized roadmap</span>
      <span class="cl__scope">{scopeNote}</span>
    </caption>
    <thead>
      <tr>
        <th scope="col">Provider</th>
        <th scope="col">
          Typical cost for this scope
          <span class="cl__axis" aria-hidden="true">{costAxis.map((t) => <span class:list={[t.minor && 'is-minor', t.end && 'is-end']} style={`left:${t.at}`}>{t.label}</span>)}</span>
        </th>
        <th scope="col">
          Time to recommendations
          <span class="cl__axis" aria-hidden="true">{weekAxis.map((t) => <span class:list={[t.minor && 'is-minor', t.end && 'is-end']} style={`left:${t.at}`}>{t.label}</span>)}</span>
        </th>
        <th scope="col">What's included</th>
        <th scope="col">Access for a 20-100 person business</th>
      </tr>
    </thead>
    <tbody>
      {rows.map(({ p, cost, time }) => (
        <tr>
          <th scope="row"><span class="cost-ledger__name">{p.category}</span></th>
          <td data-label="Typical cost for this scope">
            <span class="cost-ledger__fig">{cost.fig}</span>
            {cost.bar ? (
              <span class:list={['range-bar', 'cl__bar', cost.bar.open && 'is-open']} aria-hidden="true">
                {costTicks.map((l) => <i class="cl__tick" style={`left:${l}`}></i>)}
                <span class="range-bar__fill" style={cost.bar.open ? `--from:${cost.bar.from}` : `--from:${cost.bar.from};--to:${cost.bar.to}`}></span>
              </span>
            ) : cost.na ? (
              <span class="cost-ledger__na">{cost.na}</span>
            ) : null}
            <span class="cost-ledger__note cl__cell-note">{cost.note}</span>
          </td>
          <td data-label="Time to recommendations">
            <span class="cost-ledger__fig">{time.fig}</span>
            {time.bar ? (
              <span class="range-bar cl__bar" aria-hidden="true">
                {weekTicks.map((l) => <i class="cl__tick" style={`left:${l}`}></i>)}
                <span class="range-bar__fill" style={`--from:${time.bar.from};--to:${time.bar.to}`}></span>
              </span>
            ) : (
              <span class="cost-ledger__na">No published range</span>
            )}
            {time.note && <span class="cost-ledger__note cl__cell-note">{time.note}</span>}
          </td>
          <td data-label="What's included" class="cl__text cl__inc">
            <details class="cl__more" open data-cl-more>
              <summary><span>Details<span class="sr-only">: {p.category}</span></span><Icon name="chevron-down" /></summary>
              <dl class="cl__phone-notes">
                <div><dt class="type-label">Cost</dt><dd>{cost.note}</dd></div>
                <div><dt class="type-label">Time</dt><dd>{time.note || time.fig}</dd></div>
                <div><dt class="type-label">Included</dt><dd>{p.includes}</dd></div>
              </dl>
              <p class="cl__inc-text">{p.includes}</p>
              <div class="cl__acc"><p class="type-label cl__acc-k">Access</p><p>{p.access}</p></div>
            </details>
          </td>
          <td data-label="Access for a 20-100 person business" class="cl__text cl__acc-col">{p.access}</td>
        </tr>
      ))}
      {far.map(({ p, cost, time, lead }) => (
        <tr class="cl__far">
          <th scope="row"><span class="cost-ledger__name">{p.category}</span></th>
          <td colspan="3" class="cl__far-cell">
            <b>{lead}</b> Modeled at {cost.fig} and {time.fig} for this scope, off this chart’s scale.{' '}
            <a class="link" href="#cl-method" data-cl-open>See how it was modeled</a>
          </td>
          <td class="cl__acc-col" aria-hidden="true"></td>
        </tr>
      ))}
      <tr class="is-us ctx-dark">
        <th scope="row">
          <span class="cost-ledger__name">
            <svg class="cl__mark" viewBox="0 0 32 32" aria-hidden="true"><rect x="6" y="10" width="4" height="17" rx=".6" fill="currentColor" /><rect x="22" y="4" width="4" height="23" rx=".6" fill="currentColor" /><path d="M10 19.2 22 11.2v4.4l-12 8z" fill="var(--color-brass-400)" /></svg>
            <span>{ourName}</span>
          </span>
          <span class="cost-ledger__sub">AI does the reading and the math. A person checks every finding.</span>
        </th>
        <td data-label="Typical cost for this scope">
          {price ? (
            <Fragment>
              <span class="cost-ledger__fig">{currency(price.from)} to {currency(price.to)}</span>
              <span class="range-bar range-bar--us cl__bar" aria-hidden="true">
                {costTicks.map((l) => <i class="cl__tick" style={`left:${l}`}></i>)}
                <span class="range-bar__fill" style={`--from:${pct(price.from, COST_MAX)};--to:${pct(price.to, COST_MAX)}`}></span>
              </span>
              <span class="cost-ledger__note">One fixed fee, agreed before work starts</span>
            </Fragment>
          ) : (
            <Fragment>
              <span class="cost-ledger__fig">{ours.price}</span>
              <span class="cost-ledger__note cl__brass">A fraction of the cost of a traditional engagement</span>
            </Fragment>
          )}
        </td>
        <td data-label="Time to recommendations">
          <span class="cost-ledger__fig">{ourTime.fig}</span>
          {ourTime.bar && (
            <span class="range-bar range-bar--us cl__bar" aria-hidden="true">
              {weekTicks.map((l) => <i class="cl__tick" style={`left:${l}`}></i>)}
              <span class="range-bar__fill" style={`--from:${ourTime.bar.from};--to:${ourTime.bar.to}`}></span>
            </span>
          )}
          <span class="cost-ledger__note cl__cell-note">{ourTimeNote}</span>
        </td>
        <td data-label="What's included" class="cl__text cl__inc">
          <details class="cl__more" open data-cl-more>
            <summary><span>Details<span class="sr-only">: {ourName}</span></span><Icon name="chevron-down" /></summary>
            <dl class="cl__phone-notes">
              <div><dt class="type-label">Time</dt><dd>{ourTimeNote}</dd></div>
              <div><dt class="type-label">Included</dt><dd>{ourGet}</dd></div>
            </dl>
            <p class="cl__inc-text">{ourGet}</p>
            <div class="cl__acc"><p class="type-label cl__acc-k">Access</p><p>{ourAccess}</p></div>
          </details>
        </td>
        <td data-label="Access for a 20-100 person business" class="cl__text cl__acc-col">{ourAccess}</td>
      </tr>
    </tbody>
  </table>

  {difference && (
    <p class="cl__diff">
      <Icon name="check" />
      <span>That's <b>{currency(difference)}</b> less than the lowest modeled traditional cost for the same scope ({lowest.category.toLowerCase()}, low end).</span>
    </p>
  )}

  <div class="cmp-foot cl__foot">
    <IllustrativeLabel kind="Modeled estimate" />
    <div class="cl__foot-body">
      <p>{fnLead}{fnRest && <span class="cl__fn-rest"> {fnRest}</span>}</p>
      <details class="cl__method" id="cl-method">
        <summary><span>How each range was modeled, with {sources.length} sources</span><Icon name="chevron-down" /></summary>
        <div class="cl__method-body">
          {fnRest && <p class="cl__fn-phone">{fnRest}</p>}
          <dl class="cl__basis">
            {all.map(({ p }) => (
              <div>
                <dt>{p.category}</dt>
                <dd>{times(p.rate)}</dd>
              </div>
            ))}
          </dl>
          <p class="type-label cl__src-title">Sources</p>
          <ol class="cl__sources">
            {sources.map((s) => (
              <li><span class="cl__src-id">{s.id}</span><a class="link" href={s.url} target="_blank" rel="noopener">{s.citation}<span class="sr-only"> (opens in a new tab)</span></a></li>
            ))}
          </ol>
        </div>
      </details>
    </div>
  </div>
</div>

<style>
  /* Five columns from 1024px: rebalance the widths the base class sets for the reference's four. */
  @media (width >= 64rem) {
    .cl__table thead th:nth-child(1), .cl__table tbody th { width: 17%; }
    .cl__table thead th:nth-child(2) { width: 24%; }
    .cl__table thead th:nth-child(3) { width: 19%; }
    .cl__table thead th:nth-child(4), .cl__table thead th:nth-child(5) { width: 20%; }
  }

  /* Shared axes: tick labels in the column heads, tick lines in every bar (DESIGN.md §3.5: Geist Mono
     12px ink-3 ticks, 1px solid gridlines in --viz-grid, the bar itself in --viz-context). */
  .cl__axis { position: relative; display: block; height: 16px; margin-top: 8px; font-family: var(--font-mono); font-size: 0.75rem; font-weight: 400; line-height: 16px; color: var(--color-ink-3); font-variant-numeric: tabular-nums; white-space: nowrap; }
  .cl__axis > span { position: absolute; top: 0; transform: translateX(-50%); }
  .cl__axis > span:first-child { transform: none; }
  .cl__axis > span.is-end { transform: translateX(-100%); }
  .cl__bar { overflow: visible; }
  .cl__tick { position: absolute; top: -3px; bottom: -3px; width: 1px; margin-left: -0.5px; background: var(--viz-axis); opacity: 0.6; }
  .cl__bar .range-bar__fill { z-index: 1; }

  /* "What's included" carries the access note (tablet and phone) and, on phones, the cost and time notes,
     inside a <details> that only collapses on phones: wider screens hide its summary, the markup ships open. */
  .cl__more > summary { display: none; }
  .cl__inc-text, .cl__acc > p:last-child { margin: 0; }
  .cl__phone-notes { display: none; }
  .cl__acc { display: none; margin-top: 12px; }
  .cl__acc-k { margin-bottom: 4px; color: var(--fg-3); }
  /* 768-1023px: four columns, the access note folded under "What's included" */
  @media (48rem <= width < 64rem) {
    .cl__table thead th:nth-child(5), .cl__table .cl__acc-col { display: none; }
    .cl__table thead th:nth-child(1), .cl__table tbody th { width: 20%; }
    .cl__table thead th:nth-child(2) { width: 28%; }
    .cl__table thead th:nth-child(3) { width: 20%; }
    .cl__table thead th:nth-child(4) { width: 32%; }
    .cl__table th, .cl__table td { padding-inline: 14px; }
    .cl__table thead th:first-child, .cl__table tbody tr:not(.is-us) th { padding-left: 0; }
    .cl__table tr.is-us > .cl__inc { border-radius: 0 var(--radius-card) var(--radius-card) 0; border-top-right-radius: var(--radius-card) calc(var(--radius-card) + 12px); }
    .cl__acc { display: block; }
  }
  /* the caption must stay display: table-caption (a grid caption becomes an anonymous cell) */
  .cl__table caption > span { display: block; }
  .cl__scope { max-width: 72ch; margin-top: 6px; font-size: 0.8125rem; line-height: 1.5; color: var(--fg-3); }
  .cl__text { font-size: 0.875rem; line-height: 1.55; }
  .cost-ledger__fig + .range-bar { margin-top: 12px; }
  .range-bar + .cost-ledger__note, .cost-ledger__na + .cost-ledger__note { margin-top: 12px; }
  .cl__mark { flex: none; width: 18px; height: 18px; color: var(--color-on); }
  .is-us .cost-ledger__sub { max-width: 30ch; color: var(--color-on-2); }
  .cl__brass { color: var(--color-brass-300); }

  /* Off the chart's scale (the global strategy firm): one muted line, not a full row */
  .cl__table tr.cl__far > th, .cl__table tr.cl__far > td { padding-block: 14px; }
  .cl__far .cost-ledger__name { font-size: 0.9375rem; font-weight: 500; color: var(--fg-2); }
  .cl__far-cell { font-size: 0.875rem; line-height: 1.55; color: var(--fg-3); }
  .cl__far-cell b { font-weight: 600; color: var(--fg-2); }

  .cl__diff { display: flex; align-items: flex-start; gap: 10px; margin-top: 18px; font-size: 1rem; line-height: 1.5; color: var(--fg); }
  .cl__diff > :global(.icon) { margin-top: 4px; color: var(--accent-display); }
  .cl__diff b { font-weight: 600; }
  .cl__foot { margin-top: 24px; }
  .cl__foot-body { flex: 1 1 40ch; max-width: 92ch; }
  .cl__method { margin-top: 10px; scroll-margin-top: calc(var(--header-h) + 16px); }
  .cl__method > summary { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; list-style: none; cursor: pointer; font-size: 0.875rem; font-weight: 550; color: var(--fg); }
  .cl__method > summary::-webkit-details-marker { display: none; }
  .cl__method > summary > span { text-decoration: underline; text-decoration-color: var(--accent-line); text-underline-offset: 3px; }
  .cl__method > summary :global(.icon) { color: var(--accent-display); transition: transform 0.25s var(--ease-out-soft); }
  .cl__method[open] > summary :global(.icon) { transform: rotate(180deg); }
  .cl__method-body { display: grid; gap: 14px; padding: 8px 0 4px; }
  .cl__basis > div { padding: 10px 0; border-bottom: 1px solid var(--line); }
  .cl__basis > div:first-child { border-top: 1px solid var(--line); }
  .cl__basis dt { font-size: 0.8125rem; font-weight: 600; color: var(--fg); }
  .cl__basis dd { margin-top: 2px; }
  .cl__src-title { margin-top: 6px; }
  .cl__fn-phone { display: none; }
  .cl__sources { display: grid; gap: 8px; }
  .cl__sources li { display: grid; grid-template-columns: 4.5rem minmax(0, 1fr); gap: 12px; }
  .cl__src-id { font-family: var(--font-mono); font-size: 0.75rem; line-height: 1.8; color: var(--accent); }
  .cl__sources a { overflow-wrap: anywhere; }

  /* Phones: compact cards under one pair of axes (the column heads), our card first. Each card's
     "Details" toggle sits at the right of its name row, so a closed card is just name, figures and bars.
     The mono caption repeats the scope note under it, so phones keep it for screen readers only. */
  @media (width < 48rem) {
    .cl__table caption { margin-bottom: 4px; }
    .cl__table caption > .type-label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
    .cl__table caption > .cl__scope { margin-top: 0; }
    .cl__table thead { position: static; display: block; width: auto; height: auto; overflow: visible; clip-path: none; }
    .cl__table thead tr { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 20px; padding-bottom: 10px; border-bottom: 1px solid var(--line-strong); }
    .cl__table thead th { display: block; padding: 0; border: 0; font-size: 0.8125rem; }
    .cl__table thead th:nth-child(n) { width: auto; }
    .cl__axis > span.is-minor { display: none; }
    .cl__table thead th:nth-child(1), .cl__table thead th:nth-child(4), .cl__table thead th:nth-child(5) { display: none; }
    .cl__table tbody { display: flex; flex-direction: column; }
    .cl__table tbody tr { position: relative; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px 20px; padding: 16px 0; }
    .cl__table tbody tr > th { grid-column: 1 / -1; padding-right: 96px; }
    .cl__table tbody tr > td { margin-top: 0; }
    .cl__table td::before { display: none; }
    .cl__table .cl__inc { grid-column: 1 / -1; margin-top: -10px; }
    .cl__table .cl__more > summary { position: absolute; top: 5px; right: 0; }
    .cl__table tr.is-us .cl__more > summary { top: 7px; right: 16px; }
    .cl__table .cl__more[open] .cl__phone-notes { margin-top: 18px; padding-top: 14px; border-top: 1px solid var(--line); }
    .cl__table .cl__acc-col { display: none; }
    .cl__table .range-bar { display: block; }
    .cl__table .cl__cell-note, .cl__inc-text { display: none; }
    .cl__table tbody tr.is-us { order: -1; margin: 12px 0 8px; padding: 18px 16px 20px; }
    .cl__table tbody tr.cl__far { display: block; padding: 14px 0; }
    .cl__table tr.cl__far > th, .cl__table tr.cl__far > td { padding: 0; }
    .cl__table tr.cl__far > td { margin-top: 4px; }
    .cl__text { font-size: 0.9375rem; }
    .cl__more > summary { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; list-style: none; cursor: pointer; font-size: 0.875rem; font-weight: 550; color: var(--fg); }
    .cl__more > summary::-webkit-details-marker { display: none; }
    .cl__more > summary > span { text-decoration: underline; text-decoration-color: var(--accent-line); text-underline-offset: 3px; }
    .cl__more > summary :global(.icon) { color: var(--accent-display); transition: transform 0.25s var(--ease-out-soft); }
    .cl__more[open] > summary :global(.icon) { transform: rotate(180deg); }
    .cl__more[open] > summary { margin-bottom: 4px; }
    .cl__phone-notes { display: grid; gap: 10px; padding-bottom: 12px; }
    .cl__phone-notes dt { margin-bottom: 2px; color: var(--fg-3); }
    .cl__phone-notes dd { margin: 0; font-size: 0.875rem; line-height: 1.55; }
    .cl__acc { display: block; margin-top: 0; padding-bottom: 12px; }
    .is-us .cl__acc-k, .is-us .cl__phone-notes dt { color: var(--color-brass-300); }
    .cl__fn-rest { display: none; }
    .cl__fn-phone { display: block; }
  }
</style>

<script>
  // Phones: start each provider's "Details" closed. The markup ships open, so without JavaScript (and on
  // wider screens, where the summary is hidden) the text always shows.
  const phone = window.matchMedia('(width < 48rem)');
  const sync = () => {
    document.querySelectorAll<HTMLDetailsElement>('details[data-cl-more]').forEach((d) => {
      d.open = !phone.matches;
    });
  };
  sync();
  phone.addEventListener('change', sync);
  // "See how it was modeled" opens the method notes before jumping to them.
  document.querySelectorAll<HTMLAnchorElement>('a[data-cl-open]').forEach((a) => {
    a.addEventListener('click', () => {
      const target = document.getElementById(a.hash.slice(1));
      if (target instanceof HTMLDetailsElement) target.open = true;
    });
  });
</script>
