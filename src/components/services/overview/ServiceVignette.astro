---
// OWNER: services-a
// Tagged mini-window vignettes for the /services/ cards (DESIGN.md §6.6), ported from the reference
// #services markup: agents with status chips · cost-per-lead bars · a cited first email · a margin
// waterfall. Decorative (aria-hidden): the card copy carries the meaning.
// The waterfall is computed from the AI Consulting worked example in @/data/worth (counted savings),
// so its points agree with the "What it's worth" figures on the consulting page.
import Icon from '@/components/ui/Icon.astro';
import type { ServiceSlug } from '@/data/services';
import { getWorth } from '@/data/worth';

interface Props { slug: ServiceSlug }
const { slug } = Astro.props;

const titles: Record<ServiceSlug, string> = {
  'ai-agents': 'Agents on shift',
  marketing: 'Cost per lead',
  sales: 'First email',
  consulting: 'Margin, pts',
};

// Margin waterfall from the consulting example: EBITDA margin today, each counted saving in points,
// then the margin with counted savings.
type Step = { label: string; value: number };
const wf = (() => {
  const ex = getWorth('consulting');
  if (!ex) return null;
  // First number in a string: "$1,200,000 (8.0%)" -> 1200000.
  const num = (s: string) => Number((s.match(/\d[\d,]*(?:\.\d+)?/)?.[0] ?? '0').replace(/,/g, ''));
  const base = ex.baseline.find((b) => /^revenue and ebitda/i.test(b.label));
  if (!base) return null;
  const [revenue, ebitda] = base.value.split(';').map(num);
  const short: Record<string, string> = { Pricing: 'Price', Overtime: 'OT', Materials: 'Mat.', Freight: 'Frt.', Software: 'SW' };
  const steps: Step[] = ex.math
    .filter((r) => /^(Pricing|Overtime|Materials|Freight|Software):/.test(r.label))
    .map((r) => ({ label: short[r.label.split(':')[0]], value: (num(r.value) / revenue) * 100 }));
  const start = (ebitda / revenue) * 100;
  const end = start + steps.reduce((a, s) => a + s.value, 0);
  // Truncated scale (as in the reference vignette): today's margin at 58% of the plot, the plan at 92%.
  const lo = 58, hi = 92;
  const k = (hi - lo) / (end - start);
  const fmt = (v: number) => v.toFixed(2).replace(/0+$/, '').replace(/\.$/, '');
  const delta = (v: number) => '+' + fmt(v).replace(/^0/, '');
  let acc = lo;
  const bars = steps.map((s) => {
    const h = s.value * k;
    const bar = { label: s.label, bottom: acc, height: h, text: delta(s.value) };
    acc += h;
    return bar;
  });
  return { start: { height: lo, text: start.toFixed(1) }, bars, end: { height: hi, text: fmt(end) } };
})();
---
<div class="app-window app-window--mini vgn" aria-hidden="true">
  <div class="aw-bar">
    <span class="aw-crumb"><b>{titles[slug]}</b></span>
    <span class="aw-meta"><span class="aw-tag">Illustrative</span></span>
  </div>

  {slug === 'ai-agents' && (
    <div class="vg"><div class="vg-rows">
      <div class="vg-row"><span class="vg-glyph"><Icon name="message-square" /></span><span class="vg-row__text"><b>Customer Agent</b><small>Booked a 9:47 pm chat</small></span><span class="chip chip-done"><Icon name="check" />Booked</span></div>
      <div class="vg-row"><span class="vg-glyph"><Icon name="chart-column" /></span><span class="vg-row__text"><b>Analyst Agent</b><small>Weekly numbers ready</small></span><span class="chip chip-done"><Icon name="check" />Ready</span></div>
      <div class="vg-row"><span class="vg-glyph"><Icon name="inbox" /></span><span class="vg-row__text"><b>Executive Assistant</b><small>11 replies drafted</small></span><span class="chip chip-attention"><Icon name="user-check" />Your OK</span></div>
    </div></div>
  )}

  {slug === 'marketing' && (
    <div class="vg">
      <div class="vg-bars">
        <div class="vg-bar"><span>Search A</span><span class="vg-bar__track"><span class="vg-bar__fill vg-bar__fill--accent" style="width:46%"></span></span><span class="vg-bar__val">$44</span></div>
        <div class="vg-bar"><span>Search B</span><span class="vg-bar__track"><span class="vg-bar__fill" style="width:62%"></span></span><span class="vg-bar__val">$58</span></div>
        <div class="vg-bar"><span>Meta A</span><span class="vg-bar__track"><span class="vg-bar__fill" style="width:78%"></span></span><span class="vg-bar__val">$71</span></div>
        <div class="vg-bar"><span>Meta B</span><span class="vg-bar__track"><span class="vg-bar__fill" style="width:0"></span></span><span class="vg-bar__val vgn__paused">Paused</span></div>
      </div>
      <p class="vg-note"><span class="vgn__key"><span class="chart__key vgn__swatch"></span>Winner of a 2-week test</span><span>Moves capped at 20% a week</span></p>
    </div>
  )}

  {slug === 'sales' && (
    <div class="vg">
      <div class="aw-doc vgn__doc">Congratulations on opening the <mark class="mark-ok">Riverside office</mark><span class="marker">1</span> last month. Your new job posting mentions <mark class="mark-ok">“handling IT”</mark><span class="marker">2</span> as part of the office manager’s role.</div>
      <p class="vg-note vgn__chips"><span class="chip chip-done"><Icon name="check" />2 facts, sourced</span><span class="chip chip-attention"><Icon name="user-check" />Your OK</span></p>
    </div>
  )}

  {slug === 'consulting' && wf && (
    <div class="vg">
      <div class="vg-wf">
        <div class="vg-wf__col"><span class="vg-wf__bar vg-wf__bar--total" style={`bottom:0;height:${wf.start.height}%`}></span><span class="vg-wf__v" style={`bottom:calc(${wf.start.height}% + 4px)`}>{wf.start.text}</span></div>
        {wf.bars.map((b) => (
          <div class="vg-wf__col"><span class="vg-wf__bar" style={`bottom:${b.bottom}%;height:${b.height}%`}></span><span class="vg-wf__v" style={`bottom:calc(${b.bottom + b.height}% + 4px)`}>{b.text}</span></div>
        ))}
        <div class="vg-wf__col"><span class="vg-wf__bar vg-wf__bar--end" style={`bottom:0;height:${wf.end.height}%`}></span><span class="vg-wf__v" style={`bottom:calc(${wf.end.height}% + 4px)`}>{wf.end.text}</span></div>
      </div>
      <div class="vg-wf__l"><span>Now</span>{wf.bars.map((b) => <span>{b.label}</span>)}<span>Plan</span></div>
    </div>
  )}
</div>

<style>
  .vgn { display: flex; flex-direction: column; height: 216px; }
  .vgn > .vg { display: flex; flex: 1; flex-direction: column; justify-content: center; }
  .vgn__paused { color: var(--color-on-3); font-weight: 500; }
  .vgn__key { display: inline-flex; align-items: center; gap: 6px; }
  .vgn__swatch { --k: var(--viz-accent); display: inline-block; }
  .vgn__doc { padding: 10px 12px; font-size: 0.8125rem; line-height: 1.5; }
  .vgn__chips { gap: 6px; }
  /* Margin waterfall: ported from the reference page CSS (.vg-wf) */
  .vg-wf { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 4px; align-items: end; height: 118px; margin-top: 8px; }
  .vg-wf__col { position: relative; height: 100%; }
  .vg-wf__bar { position: absolute; left: 3px; right: 3px; border-radius: 3px 3px 0 0; background: var(--viz-accent); }
  .vg-wf__bar--total { background: var(--viz-total); }
  .vg-wf__bar--end { background: var(--viz-result); }
  .vg-wf__v { position: absolute; left: -6px; right: -6px; text-align: center; font-size: 12px; font-weight: 600; color: var(--color-on); font-variant-numeric: tabular-nums; }
  .vg-wf__l { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 4px; margin-top: 6px; padding-top: 6px; border-top: 1px solid var(--viz-axis); font-size: 12px; text-align: center; color: var(--color-on-3); }
  @media (width < 40rem) { .vgn { height: auto; } }
</style>
