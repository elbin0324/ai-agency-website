---
// Day story, 1:15 pm: the Analyst flags a margin leak as the chart draws in. OWNER: home-daystory.
// Emphasis chart (DESIGN.md §3.1, §3.5): the series the story is about in --viz-accent, the context
// line in --viz-context, 1px solid gridlines, labels at the line ends only. The SVG stretches to the
// window (preserveAspectRatio none, non-scaling strokes) and every label is HTML, so text never
// scales below 12px. The finding is stated in the copy beside the window and in its aria-label.
// The scroll build draws both lines left to right behind a scan line, shades the slide from week 4,
// then lands the end labels and the insight (math first, the owner's decision last).
import Icon from '@/components/ui/Icon.astro';
import { number } from '@/lib/format';
import { leak, leakPoints, leakMonthly } from './day-data';

const lo = 30;
const hi = 45;
const ticks = [45, 40, 35, 30];
const all = [40.6, 40.2, 40.8, 40.4, 40.1, 40.5, 40.3, 40.4];
const wh = [40.2, 40.0, 39.6, 38.3, 37.1, 35.9, 34.8, leak.to];
const W = 700;
const step = W / (wh.length - 1);
const y = (v: number) => ((hi - v) / (hi - lo)) * 100;
const path = (vals: number[]) => vals.map((v, i) => `${i ? 'L' : 'M'}${(i * step).toFixed(1)},${y(v).toFixed(2)}`).join(' ');
const bandFrom = 3; // the slide starts in week 4
const pct = (v: number) => `${v.toFixed(2)}%`;
---
<div class="sc">
  <div class="sc-head">
    <p class="aw-label">Gross margin by job type · 8 weeks</p>
    <span class="aw-status">QuickBooks · synced 1:12 pm</span>
  </div>

  <figure class="chart sc-chart">
    <ul class="chart__legend" role="list">
      <li><span class="chart__key chart__key--line" style="--k: var(--viz-accent)"></span>Water-heater installs</li>
      <li><span class="chart__key chart__key--line" style="--k: var(--viz-context)"></span>All jobs</li>
    </ul>
    <div class="sc-plot">
      <div class="sc-plot__y" aria-hidden="true">
        {ticks.map((t) => <span class="num-tab" style={`top:${pct(y(t))}`}>{t}%</span>)}
      </div>
      <div class="sc-plot__area">
        <svg viewBox={`0 0 ${W} 100`} preserveAspectRatio="none" aria-hidden="true" focusable="false">
          <defs>
            <clipPath id="ds-margin-wipe"><rect data-ds="wipe" x="0" y="-10" width={W} height="120" /></clipPath>
          </defs>
          <g data-ds="band"><rect class="viz-band" x={bandFrom * step} y="0" width={W - bandFrom * step} height="100" /></g>
          {ticks.map((t) => <line class={t === lo ? 'viz-axis' : 'viz-grid'} x1="0" x2={W} y1={y(t)} y2={y(t)} vector-effect="non-scaling-stroke" />)}
          <g clip-path="url(#ds-margin-wipe)">
            <path class="viz-line viz-line--context" d={path(all)} vector-effect="non-scaling-stroke" />
            <path class="viz-line" d={path(wh)} stroke="var(--viz-accent)" vector-effect="non-scaling-stroke" />
          </g>
        </svg>
        <span class="sc-scan" data-ds="scan" aria-hidden="true"></span>
        <span class="sc-annot" data-ds="annot" style={`left:${pct((bandFrom / (wh.length - 1)) * 100)}`}>Tank costs up 11% · prices unchanged</span>
        <span class="sc-dot" data-ds="end" style={`top:${pct(y(leak.to))}`}></span>
        <span class="sc-end sc-end--accent" data-ds="end" style={`top:${pct(y(leak.to))}`}>{leak.to}%</span>
        <span class="sc-end" data-ds="end" style={`top:${pct(y(all[all.length - 1]))}`}>{Math.round(all[all.length - 1])}%</span>
      </div>
      <div class="sc-plot__x" aria-hidden="true"><span>8 weeks ago</span><span>4 weeks ago</span><span>This week</span></div>
    </div>
  </figure>

  <div class="aw-note sc-insight" data-ds="insight">
    <p><b>Water-heater installs lost {leakPoints} points of margin.</b> Tank costs rose; the price book hasn’t changed since spring.</p>
    <p class="sc-insight__math" data-ds="math">{leak.installs} installs × ${number(leak.ticket)} × {leakPoints} pts = <b>${number(leakMonthly)} a month</b></p>
    <div class="sc-insight__act" data-ds="decide">
      <span class="chip chip-attention"><Icon name="user-check" />Price update needs your OK</span>
      <span class="app-btn">Review</span>
    </div>
  </div>
</div>

<style>
  .sc { display: flex; flex-direction: column; gap: 14px; height: 100%; min-height: 0; }
  .sc-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  /* In the pinned stage the window is tall, so the plot grows into it (the SVG stretches and every
     label is positioned in %); in the static sequence it keeps its 150px minimum. */
  .sc-chart { display: flex; flex: 1; flex-direction: column; gap: 10px; min-height: 0; }

  .sc-plot { display: grid; flex: 1; grid-template-columns: 36px minmax(0, 1fr) 40px; grid-template-rows: minmax(150px, 1fr) auto; max-height: 300px; }
  .sc-plot__y { position: relative; grid-column: 1; grid-row: 1; }
  .sc-plot__y span { position: absolute; left: 0; transform: translateY(-50%); font-size: 0.75rem; line-height: 1; color: var(--viz-text-muted); }
  .sc-plot__area { position: relative; grid-column: 2; grid-row: 1; }
  .sc-plot__area svg { display: block; width: 100%; height: 100%; overflow: visible; }
  .sc-plot__x { display: flex; justify-content: space-between; grid-column: 2; grid-row: 2; padding-top: 8px; font-size: 0.75rem; line-height: 1; color: var(--viz-text-muted); }

  /* Scan line at the drawing front (scroll build only; hidden in the final state). */
  .sc-scan { position: absolute; inset: -6px auto -6px 0; width: 100%; opacity: 0; pointer-events: none; }
  .sc-scan::before { content: ""; position: absolute; top: 0; bottom: 0; left: 0; width: 1px; background: var(--color-brass-300); opacity: 0.55; }
  .sc-annot { position: absolute; top: 4px; padding-left: 8px; border-left: 1px solid var(--viz-axis); font-size: 0.75rem; line-height: 1.3; color: var(--viz-text-muted); white-space: nowrap; }
  .sc-dot { position: absolute; left: 100%; width: 10px; height: 10px; border-radius: 50%; background: var(--viz-accent); box-shadow: 0 0 0 2px var(--viz-surface); transform: translate(-50%, -50%); }
  .sc-end { position: absolute; left: calc(100% + 10px); transform: translateY(-50%); font-size: 0.75rem; font-weight: 550; line-height: 1; color: var(--viz-text); font-variant-numeric: tabular-nums; }
  .sc-end--accent { color: var(--color-on); }

  .sc-insight { display: grid; gap: 6px; margin-top: auto; font-size: 0.8125rem; line-height: 1.45; }
  .sc-insight b { font-weight: 600; }
  .sc-insight__math { font-family: var(--font-mono); font-size: 0.75rem; color: var(--color-on-2); font-variant-numeric: tabular-nums; }
  .sc-insight__math b { font-weight: 500; color: var(--color-on); }
  .sc-insight__act { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-top: 2px; }

  @container (width < 520px) {
    .sc-head .aw-status { display: none; }
    .sc-plot { grid-template-rows: 130px auto; }
    .sc-annot { display: none; }
  }
</style>
