---
// OWNER: results (calculator)
// Home value band (COPY.md §2.6, updated for the 2026-10-14 decisions): the ivory worksheet on the navy
// desk. Intro on 4 columns (eyebrow, title, lead, short disclaimer), the compact calculator on 8: team
// time plus customer inquiries, with a link to the full five-lever calculator on /results/.
// Keep id="calculator": COPY.md anchors and other pages link here.
import RoiCalculator from '@/components/results/RoiCalculator.astro';
import { url } from '@/lib/url';
---
<section id="calculator" data-section="calculator" class="section band-navy" aria-labelledby="calculator-title">
  <div class="wrap">
    <div class="savings">
      <div class="savings__intro" data-reveal>
        <p class="eyebrow">Estimate the value</p>
        <h2 class="type-h2 savings__title" id="calculator-title" data-motion="split">What are your hours and missed calls worth?</h2>
        <p class="type-lead savings__lead">
          Four quick questions. See what agents could return in <b>staff time</b> and in <b>new jobs</b> that no longer go
          to voicemail, as a range from typical to optimistic rates.
        </p>
        <p class="savings__note">
          Modeled estimate, not a quote or a guarantee. Profit only: staff time at its loaded cost and gross profit on
          recovered jobs, never revenue. <a class="link" href={url('/results/#methodology')}>See how we calculate</a>
        </p>
      </div>
      <div class="savings__calc" data-reveal data-reveal-delay="80">
        <RoiCalculator variant="compact" id="roi-home" />
      </div>
    </div>
  </div>
</section>

<style>
  /* Ported from the reference page CSS (.calc / .calc__intro), DESIGN.md §0 and §6.22. */
  .savings { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 24px; align-items: stretch; }
  .savings__intro { grid-column: 1 / span 4; display: flex; flex-direction: column; }
  .savings__title { margin-top: 18px; }
  .savings__lead { margin-top: 16px; }
  .savings__note {
    margin-top: auto; padding-top: 18px; border-top: 1px solid var(--color-rule-dark);
    font-size: 0.8125rem; line-height: 1.55; color: var(--color-on-3);
  }
  .savings__calc { grid-column: 5 / span 8; min-width: 0; }
  @media (width < 64rem) {
    .savings__intro, .savings__calc { grid-column: 1 / -1; }
    .savings__note { margin-top: 22px; }
  }
</style>
