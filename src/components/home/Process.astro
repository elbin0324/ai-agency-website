---
// OWNER: home-story
// How it works (COPY.md §2.8, DESIGN.md §6.21): four steps on the rising halyard line, each with a
// duration and what you get. Underneath, "What you pay for, and when" (2026-10-14 critique round: the
// buyer's first question was answered only inside a closed FAQ): the three stages and how each is priced,
// in the approved FAQ and /approach/ engagement wording, never a price (BRIEF.md). Durations: COPY.md
// Appendix A #6 (the pilot's 4 to 8 weeks = Design 1 to 2 + Build and pilot 3 to 6, as on /approach/);
// staff time: Appendix A #7. Founder to confirm the structural terms (see Engagements.astro).
// Keep id="process": it is the anchor from COPY.md and may be linked from other pages.
import Section from '@/components/ui/Section.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import Steps from '@/components/blocks/Steps.astro';
import Icon from '@/components/ui/Icon.astro';
import { homeNum } from './story/sections';
import { site } from '@/config/site';
import { url } from '@/lib/url';

const steps = [
  {
    title: 'Assess',
    body: 'Free. We learn how your business runs and where the hours go, then rank your best opportunities by value.',
    time: 'A 30-minute call',
    get: 'Your top opportunities, in writing, within about 3 business days',
  },
  {
    title: 'Design',
    body: 'We map the workflow with the people who do it today and agree what the agent may do alone and what needs your OK.',
    time: 'Typically 1 to 2 weeks',
    get: 'A written plan with guardrails, a baseline and a success measure',
  },
  {
    title: 'Build and pilot',
    body: 'We connect your tools and test on your past work. Then the agent goes live, and your team approves its work.',
    time: 'Typically 3 to 6 weeks',
    get: 'A pilot report with a clear call: go, adjust or stop',
  },
  {
    title: 'Run and improve',
    body: 'We monitor, tune and fix as part of the work. Agents take on more only when you approve it.',
    time: 'Ongoing, with a monthly review',
    get: 'A monthly report in hours and dollars, against the baseline',
  },
];

// Each stage names the steps above it covers, so the strip reads as the price of the same journey.
const pricing = [
  {
    covers: 'Assess',
    price: 'Free',
    body: 'A 30-minute call, then your top opportunities in writing within about 3 business days. No obligation.',
  },
  {
    covers: 'Design, build and pilot',
    price: 'One fixed price',
    body: 'For one job, agreed in writing before work starts. Typically 4 to 8 weeks to the pilot report, with the first agent live in 2 to 4. No obligation to continue.',
  },
  {
    covers: 'Run and improve',
    price: 'A flat monthly fee',
    body: 'Covers monitoring, upkeep, changes within scope and AI usage at the agreed volumes. Outside costs, like phone minutes, at cost. No long-term contract.',
  },
];

---
<Section id="process" tightTop aria-labelledby="process-title">
  <SectionHeader
    num={homeNum.process}
    eyebrow="How it works"
    subtitle="The same four steps every time. We prove value on one job, with your team in control, before anything expands."
    titleId="process-title"
  ><span slot="title" data-motion="split">Start small. Prove it. Then scale.</span></SectionHeader>

  <div data-motion="draw" data-draw-target=".steps__rope line" data-start="top 85%" data-end="top 45%"><Steps steps={steps} label={`How an engagement with ${site.name} works`} /></div>

  <div class="proc-foot" data-reveal>
    <h3 class="type-label proc-price__title" id="process-pricing">What you pay for, and when</h3>
    <ol class="proc-price" role="list" aria-labelledby="process-pricing">
      {pricing.map((p) => (
        <li>
          <p class="proc-price__covers"><span class="sr-only">Covers: </span>{p.covers}</p>
          <p class="proc-price__fig">{p.price}</p>
          <p class="proc-price__body">{p.body}</p>
        </li>
      ))}
    </ol>
    <div class="proc-foot__row">
      <p class="proc-foot__payback">Every proposal puts our fee next to the modeled savings, so you see the payback before you sign.</p>
      <a class="link-arrow" href={url('/approach/#engagements')}><span>How pricing works</span><Icon name="arrow-right" /></a>
    </div>
    <p class="proc-foot__note">Your team’s time: a couple of hours in week one, then a short weekly check-in. Timelines depend on scope and on how quickly we can get access to your tools.</p>
  </div>
</Section>

<style>
  .proc-foot { margin-top: clamp(40px, 5vw, 64px); }
  .proc-price__title { color: var(--fg-3); }
  .proc-price { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); margin-top: 14px; border-top: 1px solid var(--line-strong); border-bottom: 1px solid var(--line); }
  .proc-price > li { padding: 20px 24px 24px; border-left: 1px solid var(--line); }
  .proc-price > li:first-child { padding-left: 0; border-left: 0; }
  .proc-price__covers { font-family: var(--font-mono); font-size: .75rem; font-weight: 500; line-height: 1.2; letter-spacing: .14em; text-transform: uppercase; color: var(--accent); }
  .proc-price__fig { margin-top: 12px; font-family: var(--font-serif); font-size: var(--text-h3); font-weight: 420; line-height: 1.2; letter-spacing: -.014em; color: var(--fg); }
  .proc-price__body { margin-top: 8px; max-width: 40ch; font-size: .9375rem; line-height: 1.55; color: var(--fg-2); text-wrap: pretty; }
  .proc-foot__row { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 4px 24px; margin-top: 16px; }
  .proc-foot__payback { font-size: 1rem; font-weight: 550; line-height: 1.45; color: var(--fg); text-wrap: pretty; }
  .proc-foot__note { margin-top: 6px; font-size: 0.8125rem; line-height: 1.5; color: var(--fg-3); }
  @media (width < 48rem) {
    .proc-price { grid-template-columns: minmax(0, 1fr); }
    .proc-price > li, .proc-price > li:first-child { padding: 18px 0 20px; border-left: 0; }
    .proc-price > li + li { border-top: 1px solid var(--line); }
  }
  @media (width < 40rem) { .proc-foot__row { flex-direction: column; align-items: flex-start; } }
</style>
