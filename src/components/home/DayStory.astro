---
// "A day with your AI workforce": the home page's pinned scroll story. OWNER: home-daystory.
// One fictional business day (Larkfield Plumbing & Air, the hero console's company) in five moments:
// 7:30 inbox triage, 9:40 a chat becomes a booked job, 1:15 a margin leak, 3:30 researched emails
// waiting for approval, 6:00 the day's summary. Numbers and their derivations: daystory/day-data.ts.
//
// Layout
// - Pinned (JS, motion allowed, >= 1024 x 560 or >= 768 x 880): the stage pins for ~3.3 screens and the
//   scroll is the clock (daystory/day-motion.ts): the time runs minute by minute, the rail fills, the
//   light moves from a warm morning to a navy evening, each window's work builds as you scroll and the
//   moments hand off in depth. Copy and rail on the left, the five windows stacked on the right.
// - Static sequence (no JS, reduced motion, phones, short screens): each moment's copy beside (or
//   above) its own window, all in their final state. With motion allowed, phones get reveals and each
//   window's work builds as it scrolls through the screen.
// The inline script below sets .is-pinned before first paint so switching layouts never shifts the page.
// Unnumbered by default; the home page passes its number (03, from home/story/sections.ts).
import Icon from '@/components/ui/Icon.astro';
import IllustrativeLabel from '@/components/ui/IllustrativeLabel.astro';
import SceneInbox from './daystory/SceneInbox.astro';
import SceneChat from './daystory/SceneChat.astro';
import SceneMargin from './daystory/SceneMargin.astro';
import SceneOutreach from './daystory/SceneOutreach.astro';
import SceneSummary from './daystory/SceneSummary.astro';
import { number } from '@/lib/format';
import {
  business, moments, clockText, hoursToday, hoursTotal, jobsBooked, approvals, inbox, inboxTotal, sales,
  leak, leakMonthly,
} from './daystory/day-data';
import { PIN_QUERY } from './daystory/pin-query';

interface Props {
  /** Section number for the rule ("02"); omitted = unnumbered. */
  num?: string;
  id?: string;
}
const { num, id = 'day' } = Astro.props;

const scenes = { inbox: SceneInbox, chat: SceneChat, margin: SceneMargin, outreach: SceneOutreach, summary: SceneSummary };
const summaries: Record<string, string> = {
  inbox: `Illustrative inbox: ${inboxTotal} overnight emails sorted into ${inbox.needYou} that need the owner, ${inbox.drafts} drafts for approval, ${inbox.tasks} assigned tasks and ${inbox.filed} filed.`,
  chat: 'Illustrative website chat: a homeowner’s AC question is safety-checked, quoted from the price book at $89 for the diagnostic visit and booked for today, 1 to 3 pm.',
  margin: `Illustrative chart: water-heater install margin fell from ${leak.from}% to ${leak.to}% over eight weeks while all jobs held near 40%, about $${number(leakMonthly)} a month.`,
  outreach: `Illustrative sales queue: ${sales.researched} property managers researched, ${sales.ready} personal first emails waiting for approval, ${sales.skipped} skipped.`,
  summary: `Illustrative end-of-day summary: ${hoursTotal.toFixed(1)} hours back, ${jobsBooked} jobs booked, ${approvals.given} approvals given and ${approvals.waiting} waiting.`,
};
const hoursMath = hoursToday.map((h) => h.hours.toFixed(1)).join(' + ');
// Same media query as day-motion.ts, inlined for the pre-paint class switch.
const preflight = `(function(){var s=document.currentScript&&document.currentScript.parentElement;if(!s||!window.matchMedia||!matchMedia(${JSON.stringify(PIN_QUERY)}).matches)return;s.classList.add('is-pinned');addEventListener('load',function(){if(!s.hasAttribute('data-ds-ready'))s.classList.remove('is-pinned');});})();`;
---
<section id={id} data-section="day" class="ds section band-sunken" aria-labelledby={`${id}-title`} data-daystory data-ds-day={business.day}>
  <script is:inline set:html={preflight}></script>

  <div class="wrap ds-intro">
    <div class="sec-rule" data-reveal>
      {num && <span class="sec-rule__num">{num}</span>}
      <span class="sec-rule__name">A day with your AI workforce</span>
      <span class="sec-rule__line"></span><span class="sec-rule__knot"></span>
    </div>
    <div class="sec-head ds-head" data-reveal>
      <h2 class="sec-head__title type-h2" id={`${id}-title`}>One business day, start to finish.</h2>
      <div class="sec-head__aside ds-aside">
        <p>Follow a fictional {business.employees}-person plumbing and heating company from the first email to the end-of-day summary.<span class="ds-hint"> Scroll to move the clock.</span></p>
        <div class="tag-row"><IllustrativeLabel /></div>
      </div>
    </div>
  </div>

  <div class="ds-pin" data-ds-pin>
    <!-- Time-of-day light (pinned stage only): warm morning, white midday, amber afternoon, navy evening. -->
    <div class="ds-sky" data-ds-skywrap aria-hidden="true">
      <i class="ds-sky__dawn" data-ds-light="dawn"></i>
      <i class="ds-sky__noon" data-ds-light="noon"></i>
      <i class="ds-sky__amber" data-ds-light="amber"></i>
      <i class="ds-sky__dusk" data-ds-light="dusk"></i>
    </div>
    <div class="wrap ds-grid">
      <div class="ds-narr" data-ds-narr>
        <div class="ds-railwrap" data-ds-railwrap aria-hidden="true">
          <div class="ds-railbox">
            <span class="ds-rail__track"><span class="ds-rail__fill" data-ds-fill></span></span>
            <ol class="ds-rail" role="list">
              {moments.map((m, i) => (
                <li class="ds-rail__item" data-ds-rail data-i={i}>
                  <span class="ds-rail__knot"><i data-ds-dot></i></span>
                  <span class="ds-rail__time num-tab">{m.time}</span>
                  <span class="ds-rail__name">{m.rail}</span>
                </li>
              ))}
            </ol>
            <span class="ds-rail__headtrack"><span class="ds-rail__head" data-ds-head><i></i></span></span>
          </div>
        </div>
        <div class="ds-copies">
          {moments.map((m, i) => (
            <article class="ds-copy" data-ds-copy data-i={i} style={`order:${i * 2}`}>
              <p class="ds-copy__meta"><span class="ds-copy__time num-tab">{m.time}</span><span class="ds-copy__agent"><Icon name={m.icon} />{m.agent}</span></p>
              <h3 class="type-h2 ds-copy__line" data-ds-line>{m.line}</h3>
              <p class="type-lead ds-copy__body">{m.body}</p>
              {m.id === 'summary' && <p class="math ds-copy__math"><b>{hoursMath}</b> = <b>{hoursTotal.toFixed(1)} h</b> across five agents</p>}
            </article>
          ))}
        </div>
        <p class="ds-cue" data-ds-cue aria-hidden="true"><span class="ds-cue__line"><i></i></span>Scroll to move the clock</p>
      </div>

      <div class="ds-win" data-ds-win>
        <div class="ds-glow" data-ds-glowwrap aria-hidden="true">
          <i class="ds-glow__warm" data-ds-light="glow-warm"></i>
          <i class="ds-glow__dusk" data-ds-light="glow-dusk"></i>
        </div>
        {moments.map((m, i) => {
          const Scene = scenes[m.id];
          return (
            <div class="ds-scene app-window" data-ds-scene={m.id} data-ds-minutes={m.minutes} data-ds-tick={m.tick} data-i={i}
              style={`order:${i * 2 + 1}`} role="img" aria-label={summaries[m.id]}>
              <div class="aw-bar">
                <span class="aw-dots"><i></i><i></i><i></i></span>
                <span class="aw-crumb"><b>{business.name}</b><span class="aw-crumb__sep">/</span><span class="ds-view" data-ds-view>{m.view}</span></span>
                <span class="aw-meta"><span class="aw-status ds-clock" data-ds-clock>{clockText(m.minutes)}</span><span class="aw-tag">Illustrative</span></span>
              </div>
              <div class="ds-stage" data-ds-stage><Scene /></div>
              <span class="ds-scrim" data-ds-scrim aria-hidden="true"></span>
            </div>
          );
        })}
      </div>
    </div>
  </div>
</section>

<script>
  import { initDayStory } from './daystory/day-motion';
  document.querySelectorAll<HTMLElement>('[data-daystory]').forEach((el) => initDayStory(el));
</script>

<style>
  .ds { --ds-win-h: clamp(460px, calc(100svh - var(--header-h) - 104px), 580px); }
  .ds-head { margin-bottom: clamp(40px, 5vw, 72px); }
  .ds-aside { display: grid; gap: 14px; }
  .ds-hint { display: none; }

  /* ---- Static sequence: no JS, reduced motion, phones and short screens. Final states, readable. */
  .ds-grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: 24px; row-gap: clamp(56px, 7vw, 104px); }
  .ds-narr, .ds-copies, .ds-win { display: contents; }
  .ds-railwrap, .ds-sky, .ds-glow, .ds-cue { display: none; }
  .ds-copy { grid-column: 1 / span 5; align-self: center; }
  .ds-scene { grid-column: 6 / -1; align-self: center; }
  .ds-stage { container-type: inline-size; padding: 18px 20px 20px; }

  .ds-copy__meta { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 16px; font-family: var(--font-mono); font-size: 0.75rem; font-weight: 500; line-height: 1.2; letter-spacing: 0.14em; text-transform: uppercase; }
  .ds-copy__time { color: var(--accent); }
  .ds-copy__agent { display: inline-flex; align-items: center; gap: 8px; color: var(--fg-2); }
  .ds-copy__agent :global(.icon) { color: var(--accent-display); }
  .ds-copy__line { margin-top: 18px; max-width: 15ch; }
  .ds-copy__body { margin-top: 18px; max-width: 42ch; }
  .ds-copy__math { margin-top: 14px; }

  .ds-clock { justify-content: center; min-width: 7.25rem; }
  .ds-view { display: inline-block; }

  @media (width < 64rem) {
    .ds-grid { grid-template-columns: minmax(0, 1fr); row-gap: 22px; }
    .ds-copy, .ds-scene { grid-column: 1; }
    .ds-copy:not([data-i="0"]) { margin-top: clamp(32px, 7vw, 56px); }
    .ds-copy__line { max-width: 18ch; }
  }
  @media (width < 40rem) {
    .ds-stage { padding: 14px; }
    .ds-scene :global(.aw-dots), .ds-scene .aw-crumb > b, .ds-scene .aw-crumb__sep { display: none; }
  }

  /* ---- Pinned stage (set by the inline script and day-motion.ts). */
  .ds:global(.is-pinned) { padding-bottom: 0; }
  .ds:global(.is-pinned) .ds-hint { display: inline; }
  .ds:global(.is-pinned) .ds-head { margin-bottom: 0; }
  /* The pinned stage centres itself in the viewport; tuck its empty top padding under the head so the
     paper between the head and the stage stays near the 120px rhythm limit (DESIGN.md §5). On short
     screens the stage has little slack above it, so the tuck shrinks to keep the head clear of the
     rail (16px at least) when the pin starts. */
  .ds:global(.is-pinned) .ds-intro {
    margin-bottom: calc(-1 * min(88px, var(--header-h) + (100vh - var(--header-h) - var(--ds-win-h)) / 2 - 16px));
    margin-bottom: calc(-1 * min(88px, var(--header-h) + (100svh - var(--header-h) - var(--ds-win-h)) / 2 - 16px));
  }
  .ds:global(.is-pinned) .ds-pin { position: relative; box-sizing: border-box; display: flex; flex-direction: column; justify-content: center; height: 100vh; height: 100svh; padding-top: var(--header-h); }
  .ds:global(.is-pinned) .ds-grid { position: relative; z-index: 1; row-gap: 0; align-items: stretch; }
  .ds:global(.is-pinned) .ds-narr { display: grid; grid-column: 1 / span 5; grid-template-rows: auto minmax(0, 1fr) auto; height: var(--ds-win-h); padding-right: clamp(0px, 2vw, 32px); }
  .ds:global(.is-pinned) .ds-railwrap { display: block; padding-top: 6px; }
  /* One track as tall as the longest copy, centred; every copy starts on the same line. */
  .ds:global(.is-pinned) .ds-copies { display: grid; align-content: center; align-items: start; }
  .ds:global(.is-pinned) .ds-copies > * { grid-area: 1 / 1; align-self: start; margin: 0; }
  .ds:global(.is-pinned) .ds-copy { will-change: transform, opacity; }
  .ds:global(.is-pinned) .ds-copy:not([data-i="0"]) { opacity: 0; }
  .ds:global(.is-pinned) .ds-win { position: relative; isolation: isolate; display: grid; grid-column: 6 / -1; height: var(--ds-win-h); }
  .ds:global(.is-pinned) .ds-win > .ds-scene { grid-area: 1 / 1; }
  .ds:global(.is-pinned) .ds-scene { display: flex; flex-direction: column; height: 100%; transform-origin: 50% 0; will-change: transform, opacity; }
  .ds:global(.is-pinned) .ds-scene:not([data-i="0"]) { opacity: 0; visibility: hidden; }
  .ds:global(.is-pinned) .ds-stage { flex: 1; min-height: 0; }
  .ds:global(.is-pinned) .ds-rail__item:not([data-i="0"]) { opacity: 0.42; }
  .ds:global(.is-pinned) .ds-rail__item:not([data-i="0"]) .ds-rail__knot i { transform: scale(0); }
  .ds:global(.is-pinned) .ds-rail__fill { transform: scaleX(0); }
  /* One step darker than the static sequence, for headroom under the evening light. */
  .ds:global(.is-pinned) .ds-rail__name, .ds:global(.is-pinned) .ds-copy__math { color: var(--fg-2); }

  /* Time-of-day light (founder request, 2026-10-14: "a warm early tone to a deep evening navy"; the
     one place the site's light is coloured, DESIGN.md §7.2). day-motion.ts cross-fades four broad
     washes with the scroll: warm light at dawn, white daylight at midday, amber in the late afternoon,
     navy at dusk. They lean to the window side and stay faint over the copy column, so ink-2, ink-3
     and brass-700 text keep AA at every hour. The stage's top and bottom edges are masked, so no seam
     shows as the section scrolls in and out. Opacity only. No overflow clip on this layer (its washes
     are exactly its size): Chrome's layout-shift tracker reports a clipped absolute layer as a
     full-screen jump when the pin switches to fixed. */
  .ds:global(.is-pinned) .ds-sky {
    display: block; position: absolute; inset: 0; z-index: 0; pointer-events: none;
    -webkit-mask-image: linear-gradient(180deg, transparent, #000 9%, #000 88%, transparent);
    mask-image: linear-gradient(180deg, transparent, #000 9%, #000 88%, transparent);
  }
  .ds-sky > i { position: absolute; inset: 0; opacity: 0; will-change: opacity; }
  .ds-sky__dawn {
    background:
      linear-gradient(90deg, color-mix(in srgb, var(--color-paper-raised) 60%, transparent), transparent 42%),
      linear-gradient(90deg, transparent 34%, color-mix(in srgb, var(--color-brass-200) 46%, transparent) 72%, color-mix(in srgb, var(--color-brass-200) 62%, transparent));
  }
  .ds-sky__noon { background: linear-gradient(90deg, color-mix(in srgb, var(--color-white) 40%, transparent), color-mix(in srgb, var(--color-white) 18%, transparent) 50%, color-mix(in srgb, var(--color-white) 46%, transparent)); }
  .ds-sky__amber { background: linear-gradient(90deg, color-mix(in srgb, var(--color-brass-200) 12%, transparent), transparent 30%, color-mix(in srgb, var(--color-brass-200) 50%, transparent) 64%, color-mix(in srgb, var(--color-brass-300) 46%, transparent)); }
  /* Dusk: over the copy a cool wash as light as the paper (attention-wash), so the hour turns blue
     without costing contrast; deep navy on the window side, where no paper text sits. */
  .ds-sky__dusk {
    background: linear-gradient(90deg, color-mix(in srgb, var(--color-attention-wash) 60%, transparent), color-mix(in srgb, var(--color-attention-wash) 44%, transparent) 32%, color-mix(in srgb, var(--color-navy-700) 18%, transparent) 60%, color-mix(in srgb, var(--color-navy-700) 34%, transparent));
  }
  /* The window's own glow: a halo that follows its rounded frame (the window covers the middle). Warm
     white in daylight, deep navy at dusk. A rasterized shadow on its own layer; only opacity changes. */
  .ds:global(.is-pinned) .ds-glow { display: block; position: absolute; inset: 0; z-index: -1; pointer-events: none; }
  .ds-glow > i { position: absolute; inset: 0; border-radius: var(--radius-window); opacity: 0; will-change: opacity; }
  .ds-glow__warm { box-shadow: 0 0 64px 12px color-mix(in srgb, var(--color-white) 58%, var(--color-brass-200)); }
  .ds-glow__dusk { box-shadow: 0 0 72px 14px color-mix(in srgb, var(--color-navy-500) 46%, transparent); }

  /* Depth: an outgoing window darkens as it falls back behind the next one. */
  .ds-scrim { display: none; }
  .ds:global(.is-pinned) .ds-scrim { display: block; position: absolute; inset: 0; z-index: 9; background: var(--color-navy-950); opacity: 0; pointer-events: none; }

  /* Progress rail: five stops on a brass line that fills with the scroll; the knot at its head is "now". */
  .ds-railbox { position: relative; }
  .ds-rail { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); }
  .ds-rail__track, .ds-rail__headtrack { position: absolute; top: 3px; left: 3px; width: 80%; height: 1px; }
  .ds-rail__track { background: var(--line-strong); }
  .ds-rail__fill { position: absolute; left: 0; right: 0; top: -0.5px; height: 2px; border-radius: 1px; background: var(--accent-line); transform-origin: 0 50%; }
  .ds-rail__head { position: absolute; inset: 0; z-index: 1; }
  .ds-rail__head > i { position: absolute; top: -4px; left: -4.5px; width: 9px; height: 9px; border-radius: 50%; background: var(--accent-line); box-shadow: 0 0 0 4px color-mix(in srgb, var(--color-brass-500) 18%, transparent); }
  .ds-rail__item { position: relative; display: grid; gap: 6px; padding-top: 20px; }
  .ds-rail__knot { position: absolute; top: 0; left: 0; width: 7px; height: 7px; border-radius: 50%; background: var(--color-paper-sunken); box-shadow: inset 0 0 0 1.25px var(--accent-line); }
  .ds-rail__knot i { position: absolute; inset: 1.5px; border-radius: 50%; background: var(--accent-line); }
  .ds-rail__time { font-family: var(--font-mono); font-size: 0.75rem; font-weight: 500; line-height: 1.2; letter-spacing: 0.06em; text-transform: uppercase; color: var(--fg); white-space: nowrap; }
  .ds-rail__name { font-size: 0.8125rem; line-height: 1.3; color: var(--fg-3); }

  /* Scroll cue at the start of the pin; it fades as the clock starts to move. */
  .ds:global(.is-pinned) .ds-cue { display: flex; align-items: center; gap: 12px; padding-top: 12px; font-family: var(--font-mono); font-size: 0.75rem; font-weight: 500; line-height: 1.2; letter-spacing: 0.14em; text-transform: uppercase; color: var(--fg-2); }
  .ds-cue__line { position: relative; flex: none; width: 1px; height: 30px; overflow: hidden; background: var(--line-strong); }
  .ds-cue__line > i { position: absolute; top: 0; left: -1px; width: 3px; height: 10px; border-radius: 2px; background: var(--accent-line); animation: ds-cue 1.9s var(--ease-in-out-soft) infinite; }
  @keyframes ds-cue { 0% { transform: translateY(-10px); opacity: 0; } 25% { opacity: 1; } 100% { transform: translateY(30px); opacity: 0; } }

  @media (width < 80rem) { .ds-rail__name { display: none; } }
  /* Short laptop screens: the times carry the rail and the copy keeps its room. */
  @media (width >= 64rem) and (height < 40rem) { .ds:global(.is-pinned) .ds-rail__name { display: none; } }

  @media (width < 64rem) {
    .ds:global(.is-pinned) { --ds-win-h: clamp(440px, calc(100svh - var(--header-h) - 400px), 560px); }
    .ds:global(.is-pinned) .ds-grid { grid-template-columns: minmax(0, 1fr); row-gap: 28px; }
    .ds:global(.is-pinned) .ds-narr { grid-column: 1; grid-template-rows: auto auto; row-gap: 22px; height: auto; padding-right: 0; }
    .ds:global(.is-pinned) .ds-win { grid-column: 1; }
    .ds:global(.is-pinned) .ds-rail__name { display: block; }
    /* Stacked tablets: no room under the copy; the intro's "Scroll to move the clock" carries the cue. */
    .ds:global(.is-pinned) .ds-cue { display: none; }
    /* The window sits under the copy here, so the light leans down instead of right. */
    .ds:global(.is-pinned) .ds-sky__dawn { background: linear-gradient(180deg, color-mix(in srgb, var(--color-paper-raised) 60%, transparent), transparent 40%, color-mix(in srgb, var(--color-brass-200) 54%, transparent)); }
    .ds:global(.is-pinned) .ds-sky__noon { background: linear-gradient(180deg, color-mix(in srgb, var(--color-white) 40%, transparent), color-mix(in srgb, var(--color-white) 30%, transparent)); }
    .ds:global(.is-pinned) .ds-sky__amber { background: linear-gradient(180deg, color-mix(in srgb, var(--color-brass-200) 10%, transparent), transparent 36%, color-mix(in srgb, var(--color-brass-200) 50%, transparent) 70%, color-mix(in srgb, var(--color-brass-300) 42%, transparent)); }
    .ds:global(.is-pinned) .ds-sky__dusk { background: linear-gradient(180deg, color-mix(in srgb, var(--color-attention-wash) 60%, transparent), color-mix(in srgb, var(--color-attention-wash) 44%, transparent) 42%, color-mix(in srgb, var(--color-navy-700) 28%, transparent)); }
  }
</style>
