---
// OWNER: theater. Home "Agent demos" (#demos): the six agents at work, picked from a row of large tabs over one
// player (DESIGN.md §6.10, §6.12; the picker is ./theater/DemoPicker.astro). Copy: content/COPY.md §2.5, made
// plainer (2026-10-14: "say plainly that these are the agents at work"); per-demo lines in
// src/components/demos-page/demo-copy.ts; run times from the demo definitions (./theater/runtimes.ts).
// Placement (2026-10-14, founder: demos "front and center"): right after the integrations strip, as the proof of
// the hero's promise (2026-10-21: the hero's cards and agent names open their demo here, and the control room
// follows). In that slot it opens the page like the hero and the integrations strip, so its rule carries
// no number by default; the home page passes 01 (home/story/sections.ts) so the sequence never skips.
// Behavior (DEMO_ENGINE.md "Programmatic control"):
//   - Only the selected demo plays. On tabs:change the old demo gets demo:pause and the new one demo:play
//     (a paused demo resumes when its tab comes back; a finished one replays).
//   - Each tab's bar follows its demo's progress (./theater/demo-progress.ts: demo:step, demo:ended and the
//     player's own chapters); a demo that reaches its result (demo:ended) is marked "Watched".
//   - About 4 s after the selected demo's demo:ended, the next tab is selected, unless the visitor has
//     interacted with the theater (click, tap, key, focus, or scrolling the rail by hand; a touch that only
//     scrolls the page past it doesn't count). The next tab shows "Up next" and fills while it counts down; the
//     countdown holds while the pointer is over the theater, the theater is out of view or the page is hidden.
//     It stops after the last demo and never runs with reduced motion.
//   - Under 1200px the picker is a swipeable rail: it fades the edge that has more cards, flips its swipe hint at
//     the end and keeps the selected card in view.
//   - Lazy demos (phone performance): only the first demo is live DOM at load. The other five wait inside a
//     <template> (parsed, never styled or laid out) and are moved into their panel and mounted the first time
//     their tab is selected (mountDemos(panel), DEMO_ENGINE.md "Lazy mounting"). A mouse resting on a tab for
//     150 ms, or the countdown to it, prepares that demo in its hidden panel first, so the switch is instant.
//   - Without JavaScript the picker hides (it can't switch) and the first demo shows its final state; "See all six
//     demos" leads to /demos/.
import Section from '@/components/ui/Section.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import Icon from '@/components/ui/Icon.astro';
import DemoPicker, { type PickerItem } from '@/components/home/theater/DemoPicker.astro';
import { clock, runtimeMs, spoken } from '@/components/home/theater/runtimes';
import CustomerAgentDemo from '@/components/demos/CustomerAgentDemo.astro';
import AnalystDemo from '@/components/demos/AnalystDemo.astro';
import AssistantDemo from '@/components/demos/AssistantDemo.astro';
import MarketingDemo from '@/components/demos/MarketingDemo.astro';
import SalesDemo from '@/components/demos/SalesDemo.astro';
import ConsultingDemo from '@/components/demos/ConsultingDemo.astro';
import { demoCopy } from '@/components/demos-page/demo-copy';
import { site } from '@/config/site';
import { url } from '@/lib/url';

interface Props {
  /** Section rule number ("03"). Unnumbered by default: see "Placement" above. */
  num?: string;
}
const { num } = Astro.props;
const PREFIX = 'theater';

const components = {
  customer: CustomerAgentDemo,
  analyst: AnalystDemo,
  assistant: AssistantDemo,
  marketing: MarketingDemo,
  sales: SalesDemo,
  consulting: ConsultingDemo,
};
const panelId = (id: string) => `${PREFIX}-panel-${id}`;
// "All six run in under four minutes": summed from the demo definitions, so it can't drift from the players.
const totalMs = Object.values(runtimeMs).reduce((t, ms) => t + ms, 0);
const underMinutes = Math.floor(totalMs / 60000) + 1;
const say = (n: number) => ['zero', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine'][n] ?? String(n);
const items: PickerItem[] = demoCopy.map((d) => ({
  id: d.id,
  label: d.label,
  icon: d.icon,
  outcome: d.outcome,
  runtime: clock(runtimeMs[d.id]),
  runtimeSpoken: spoken(runtimeMs[d.id]),
  panelId: panelId(d.id),
}));
---
<Section id="demos" tone="sunken" aria-labelledby="demos-title" class="theater-band">
  <SectionHeader num={num} eyebrow="Agent demos" titleId="demos-title" align="center" size="h1" class="theater-head"><span slot="title" data-motion="split">Watch the AI agents at work.</span>
    <p>Six short simulations, one per agent, from the first message to the finished result, with the checks and handoffs we build in. All six run in under {say(underMinutes)} minutes.</p>
    <a class="link-arrow mt-2" href={url(site.ctas.demos.href)}><span>See all six demos</span><Icon name="arrow-right" /></a>
  </SectionHeader>

  <div class="theater" id="demos-player" data-theater>
    <div class="theater__pick" data-reveal><DemoPicker items={items} idPrefix={PREFIX} label="Agent demos" /></div>
    <div class="theater__stage" data-reveal data-reveal-delay="80">
      {demoCopy.map((d, i) => {
        const Demo = components[d.id];
        return (
          <div
            role="tabpanel"
            id={panelId(d.id)}
            aria-labelledby={`${PREFIX}-name-${d.id}`}
            class="theater__panel"
            data-theater-panel={d.id}
            hidden={i !== 0}
          >
            {i === 0 ? <Demo /> : <template data-theater-demo><Demo /></template>}
            <p class="theater__foot">
              <a class="link-arrow" href={url(d.link.href)}><span>{d.link.label}</span><Icon name="arrow-right" /></a>
            </p>
          </div>
        );
      })}
    </div>
  </div>
</Section>

<style>
  /* 2026-10-21: the stage's head is centered and a size up (type-h1 on the h2), a beat no other section uses, so the
     demos read as the page's main act; the band's hairline edges mark it off from the paper around it. */
  .theater-band { border-block: 1px solid var(--color-rule); }
  .theater-band :global(.theater-head) { margin-bottom: clamp(28px, 3.4vw, 44px); }
  .theater-band :global(.theater-head .sec-head__aside) { display: grid; justify-items: center; }
  /* The hero's "Watch the agents work" (#demos-player) lands here, with the picker and the whole player on a
     1440 x 900 screen. The reveals sit on the children, so the anchor itself never moves while it is measured. */
  .theater { scroll-margin-top: -12px; }
  .theater__pick { margin-bottom: 12px; }
  .theater__foot { display: flex; justify-content: flex-end; margin-top: 2px; }
  @media (width < 48rem) {
    .theater__pick { margin-bottom: 16px; }
    .theater__foot { justify-content: flex-start; }
  }
</style>

<script>
  import { initTabs, selectTab, type TabsChangeDetail } from '@/components/blocks/tabs';
  import { getDemo, mountDemos } from '@/scripts/demo-engine';
  import { trackProgress } from '@/components/home/theater/demo-progress';

  const ADVANCE_MS = 4000;
  const PREPARE_AFTER_MS = 150; // hover intent: a pointer passing over the row prepares nothing
  const idle = (fn: () => void) => (typeof requestIdleCallback === 'function' ? requestIdleCallback(fn, { timeout: 1000 }) : setTimeout(fn, 200));

  function initTheater(theater: HTMLElement) {
    if (theater.hasAttribute('data-theater-ready')) return;
    const picker = theater.querySelector<HTMLElement>('[data-picker]');
    const rail = picker?.querySelector<HTMLElement>('[role="tablist"]');
    if (!picker || !rail) return;
    initTabs(picker);
    theater.setAttribute('data-theater-ready', '');
    theater.style.setProperty('--advance', `${ADVANCE_MS}ms`);

    const tabs = Array.from(rail.querySelectorAll<HTMLElement>('[role="tab"]'));
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    const tabOf = (id: string | null | undefined) => tabs.find((t) => t.dataset.tab === id) ?? null;
    const panelOf = (id: string | null | undefined) => (id ? theater.querySelector<HTMLElement>(`[data-theater-panel="${id}"]`) : null);
    const demoOf = (id: string | null | undefined) => panelOf(id)?.querySelector<HTMLElement>('[data-demo]') ?? null;
    const send = (el: HTMLElement | null, type: 'demo:play' | 'demo:pause') => el?.dispatchEvent(new CustomEvent(type));

    // ---- Progress: each live demo paints its tab's bar (--p, 0..1).
    const tracked = new WeakSet<HTMLElement>();
    const track = (panel: HTMLElement | null) => {
      const root = panel?.querySelector<HTMLElement>('[data-demo]');
      const tab = tabOf(panel?.dataset.theaterPanel);
      if (!root || !tab || tracked.has(root)) return;
      tracked.add(root);
      trackProgress(root, (p) => tab.style.setProperty('--p', p.toFixed(4)));
    };

    // ---- Lazy demos: only the first panel's demo is live at load. Each other one waits in a <template> until its
    // tab is first selected or prepared, then moves into its panel and mounts.
    let waiting: HTMLElement | null = null; // selected, but its definition has not registered yet
    const instantiate = (panel: HTMLElement | null) => {
      const tpl = panel?.querySelector<HTMLTemplateElement>(':scope > template[data-theater-demo]');
      if (!panel || !tpl) return;
      tpl.replaceWith(tpl.content); // used once, so move the nodes instead of cloning them
      mountDemos(panel);
      track(panel);
    };
    const prepare = (id: string | undefined) => idle(() => instantiate(panelOf(id)));
    const play = (id: string) => {
      instantiate(panelOf(id));
      const root = demoOf(id);
      waiting = root && !getDemo(root) ? root : null;
      if (!waiting) send(root, 'demo:play');
    };
    // A demo whose definition registers after its markup went in mounts then (DEMO_ENGINE.md "Lazy mounting").
    theater.addEventListener('demo:ready', (e) => {
      if (!waiting || e.target !== waiting) return;
      waiting = null;
      send(e.target as HTMLElement, 'demo:play');
    });
    // A tab picked before this script ran still gets its demo; it autoplays in view.
    const first = tabs.find((t) => t.getAttribute('aria-selected') === 'true')?.dataset.tab;
    instantiate(panelOf(first));
    tabs.forEach((t) => track(panelOf(t.dataset.tab)));

    // Prepare a demo before it is picked: a mouse that rests on its tab. Only where the primary pointer hovers:
    // after a tap, WebKit reports a "mouse" over whichever card the rail scrolls under the finger. (Keyboard focus
    // needs nothing: arrows select as they move, and selecting mounts at once.)
    const hovers = window.matchMedia('(hover: hover)');
    let hoverTimer = 0;
    let hoverTab: HTMLElement | null = null;
    rail.addEventListener('pointerover', (e) => {
      if (!hovers.matches || (e.pointerType !== 'mouse' && e.pointerType !== 'pen')) return;
      const tab = (e.target as Element).closest<HTMLElement>('[role="tab"]');
      if (tab === hoverTab) return; // moving between the parts of one card
      hoverTab = tab;
      window.clearTimeout(hoverTimer);
      if (tab) hoverTimer = window.setTimeout(() => prepare(tab.dataset.tab), PREPARE_AFTER_MS);
    });
    rail.addEventListener('pointerleave', () => {
      hoverTab = null;
      window.clearTimeout(hoverTimer);
    });

    // ---- Rail (under 1200px): edge fades and the swipe hint, and keep the selected card in view.
    const edges = () => {
      const max = rail.scrollWidth - rail.clientWidth;
      const start = max > 1 && rail.scrollLeft > 4;
      const end = max > 1 && max - rail.scrollLeft > 4;
      rail.toggleAttribute('data-more-start', start);
      rail.toggleAttribute('data-more-end', end);
      picker.toggleAttribute('data-at-end', start && !end);
    };
    // A card that is already whole stays put; any other one scrolls to its own snap position (its start at the
    // rail's scroll padding). Scrolling by an arbitrary amount instead lets the mandatory snap carry the rail on
    // to the neighbouring card, leaving the selected one half off-screen.
    const keepInView = (tab: HTMLElement) => {
      if (rail.scrollWidth - rail.clientWidth < 2) return;
      const pad = parseFloat(getComputedStyle(rail).scrollPaddingInlineStart) || 0;
      const l = rail.getBoundingClientRect();
      const t = tab.getBoundingClientRect();
      if (t.left >= l.left + pad - 1 && t.right <= l.right - pad + 1) return;
      rail.scrollTo({ left: rail.scrollLeft + t.left - l.left - pad, behavior: reduced.matches ? 'auto' : 'smooth' });
    };
    // Swiping or side-scrolling the rail by hand means the visitor is browsing: stop auto-advance, which would
    // otherwise pull the rail back to the playing card. (A finger that scrolls the page vertically never scrolls
    // the rail, and layout-driven snapping happens without a touch, so neither counts.)
    let touching = false;
    rail.addEventListener('touchstart', () => (touching = true), { passive: true });
    rail.addEventListener('touchend', () => (touching = false), { passive: true });
    rail.addEventListener('touchcancel', () => (touching = false), { passive: true });
    rail.addEventListener('wheel', (e) => Math.abs(e.deltaX) > Math.abs(e.deltaY) && interact(), { passive: true });
    rail.addEventListener('scroll', () => {
      edges();
      if (touching) interact();
    }, { passive: true });
    if ('ResizeObserver' in window) new ResizeObserver(edges).observe(rail);
    edges();

    // ---- Auto-advance after demo:ended
    let interacted = false;
    let next: HTMLElement | null = null;
    let timer = 0;
    let startedAt = 0;
    let remaining = 0;
    const holds = new Set<string>();

    const stopCountdown = () => {
      window.clearTimeout(timer);
      timer = 0;
      next?.classList.remove('is-next');
      next = null;
    };
    const advance = () => {
      const tab = next;
      stopCountdown();
      if (tab && !interacted) selectTab(picker, tab.dataset.tab ?? '');
    };
    const run = () => {
      if (!next || timer || holds.size) return;
      startedAt = performance.now();
      timer = window.setTimeout(advance, Math.max(0, remaining));
    };
    const hold = (why: string, on: boolean) => {
      if (on) holds.add(why);
      else holds.delete(why);
      theater.toggleAttribute('data-holding', holds.size > 0);
      if (holds.size && timer) {
        window.clearTimeout(timer);
        timer = 0;
        remaining -= performance.now() - startedAt;
      } else run();
    };
    const startCountdown = (tab: HTMLElement) => {
      stopCountdown();
      next = tab;
      remaining = ADVANCE_MS;
      tab.classList.add('is-next');
      run();
    };
    function interact() {
      interacted = true;
      stopCountdown();
    }

    // Any click, tap, key press or focus inside the theater means the visitor is driving. A mouse counts on
    // press; a finger or pen only on a finished tap (click), because a touch that scrolls the page past the
    // theater also fires pointerdown (then pointercancel, no click). Nothing here or in the demo engine
    // dispatches clicks, so auto-advance never trips this.
    theater.addEventListener('pointerdown', (e) => {
      if (e.pointerType === 'mouse') interact();
    });
    theater.addEventListener('click', interact);
    theater.addEventListener('keydown', interact);
    theater.addEventListener('focusin', interact);
    theater.addEventListener('pointerenter', (e) => e.pointerType === 'mouse' && hold('hover', true));
    theater.addEventListener('pointerleave', (e) => e.pointerType === 'mouse' && hold('hover', false));
    document.addEventListener('visibilitychange', () => hold('page', document.hidden));
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(
        ([e]) => {
          const vh = e.rootBounds?.height ?? window.innerHeight;
          const seen = e.isIntersecting ? e.intersectionRect.height / Math.min(e.boundingClientRect.height, vh) : 0;
          hold('offscreen', seen < 0.5);
        },
        { threshold: [0, 0.25, 0.5, 0.75, 1] },
      ).observe(theater);
    }

    theater.addEventListener('demo:ended', (e) => {
      const panel = (e.target as Element).closest<HTMLElement>('[data-theater-panel]');
      if (!panel) return;
      tabOf(panel.dataset.theaterPanel)?.setAttribute('data-watched', '');
      if (interacted || reduced.matches || panel.hidden) return;
      const i = tabs.findIndex((t) => t.dataset.tab === panel.dataset.theaterPanel);
      const tab = tabs[i + 1];
      if (!tab) return;
      startCountdown(tab);
      prepare(tab.dataset.tab); // so the switch is instant
    });

    // Only the selected demo plays.
    picker.addEventListener('tabs:change', (e) => {
      const d = (e as CustomEvent<TabsChangeDetail>).detail;
      stopCountdown();
      send(demoOf(d.previousId), 'demo:pause');
      play(d.id);
      keepInView(d.tab);
    });
  }

  document.querySelectorAll<HTMLElement>('[data-theater]').forEach(initTheater);
</script>
