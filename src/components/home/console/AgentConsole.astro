---
// The agent console, the annotated FIG. 1 of the home control room (#control, ../ControlRoom.astro; DESIGN.md
// §6.10, §6.11, §9.4). OWNER: home-hero. Until 2026-10-21 it sat in the hero; it moved into its own section so
// the hero can make one bold promise, and the section's heading now carries the "Try it" invitation.
// A small working product, not a picture of one: pick an agent or a period, switch the log tabs,
// review a request and approve or decline it. Behavior lives in ./console-app.ts, sample data in
// ./console-data.ts, and the figures both sides print in ./console-model.ts.
// This file renders the first state (All agents, 7 days), which is also the page without JavaScript.
//
// Accessibility: the window is a labelled region (described by the summary below), every control is
// a real button (aria-pressed toggles, a tablist for the log, disclosure buttons for Review), and a
// polite status line announces what each action changed. The live ticker is not announced; it pauses
// while the pointer or keyboard focus is inside, offscreen, in a hidden tab, and from its own button.
//
// Layout: sidebar + main + rail at 1280px and up; agent chips + main + rail from 1024px; one column
// below 1024px; on phones the simplified console: agent chips, 2 KPIs, the requests, 3 log rows.
// Heights are reserved (fixed body from 1024px, fixed request cards, fixed log rows), so nothing on
// the page moves when the content changes. An open request overlays what sits below it.
import Icon from '@/components/ui/Icon.astro';
import Badge from '@/components/ui/Badge.astro';
import Logo from '@/components/ui/Logo.astro';
import IllustrativeLabel from '@/components/ui/IllustrativeLabel.astro';
import ConsoleRow from './ConsoleRow.astro';
import {
  agent, agentShort, approvals, business, clockLabel, decisionRows, hoursByAgent, hoursTotal, legend,
  liveRows, logRows, model, roster, rowTime, scene, toolCount, valueMath,
} from './console-data';
import { currency, number } from '@/lib/format';
import { url } from '@/lib/url';
import { PERIODS, fmtH, fmtN, series, sparkGeometry, subHtml, tasks, tiles, unitText, type View } from './console-model';

const view: View = { agent: 'all', period: '7d', tally: {}, pending: approvals.map((a) => a.id), approved: [] };
const kpiTiles = tiles(model, view);
const geo = sparkGeometry(series(model, view));

// First paint matches what the script shows for All agents / 7 days / All: the 6 newest rows of the week.
const shown = new Set(logRows.filter((r) => (r.day ?? 0) <= 6).slice(0, 6));
const maxHours = Math.max(...hoursByAgent.map((a) => a.hours));
const waiting = approvals.length;
const headSub = `<b class="num-tab">${tasks(model, 'all', '7d', {}).toLocaleString('en-US')}</b> tasks ${model.periods['7d'].phrase} · <span class="you">${waiting} waiting on you</span>`;

const tabs = [
  { id: 'all', label: 'All' },
  { id: 'you', label: 'Needs you' },
  { id: 'handoff', label: 'Handoffs' },
];

const summary =
  `Interactive illustration: the agent console of ${business.name}, a fictional ${business.employees}-person ` +
  `${business.kind}, on a Tuesday evening with the office closed. Five agents are at work and every action is ` +
  `logged with its time. ${waiting} requests wait for the owner's approval: first emails from the Sales Agent and ` +
  `a budget move from the Marketing Director. Results are tracked in hours: ${fmtH(hoursTotal)} hours back over ` +
  `the last 7 days. Pick an agent or a period to filter, review a request, then approve or decline it.`;

/** "[1]" in the email copy becomes a numbered source marker. */
const markers = (text: string) =>
  text.replace(/\[(\d)\]/g, '<span class="marker" aria-hidden="true">$1</span><span class="sr-only"> (source $1)</span>');

const lines = Object.fromEntries(
  approvals.map((a) => [a.id, { pending: roster.find((r) => r.appr === a.id)?.line ?? '', approved: a.done.approved.line, declined: a.done.declined.line }]),
);
const json = JSON.stringify({ model, scene, lines }).replace(/</g, '\\u003c');
---
<figure class="con-figure" data-console data-day={scene.day} data-minutes={scene.minutes}>
  <div class="app-window con-win" role="region" aria-label="Agent console, interactive demo" aria-describedby="con-summary" data-motion="tilt-in">
    <p id="con-summary" class="sr-only">{summary}</p>
    <div class="aw-bar">
      <span class="aw-dots"><i></i><i></i><i></i></span>
      <span class="aw-crumb con-crumb">
        <Logo variant="dark" href={null} wordmark={false} size={18} />
        <b>{business.name}</b>
        <span class="aw-crumb__sep con-lg" aria-hidden="true">/</span><span class="con-lg" data-crumb>Agent activity</span>
      </span>
      <span class="aw-meta">
        <span class="aw-seg con-period con-md" role="group" aria-label="Time period">
          {PERIODS.map((p) => (
            <button type="button" data-period={p} aria-pressed={p === '7d' ? 'true' : 'false'}>{model.periods[p].label}</button>
          ))}
        </span>
        <button type="button" class="live con-live" data-live hidden>
          <i></i><span data-live-label>Live</span><span class="sr-only" data-live-sr>: pause updates</span>
        </button>
        <span class="aw-status num-tab con-lg" data-clock>{clockLabel(scene.day, scene.minutes)}</span>
        <span class="aw-tag">Illustrative</span>
      </span>
    </div>

    <div class="con-body">
      <div class="con-side">
        <div class="con-side__head"><span class="aw-label" id="con-agents-label">Agents</span><span>{roster.length} working</span></div>
        <div class="con-agents" role="group" aria-labelledby="con-agents-label">
          <button type="button" class="con-agent" data-agent="all" aria-pressed="true">
            <span class="vg-glyph con-glyph"><Icon name="users" /></span>
            <span class="con-agent__text"><b>All agents</b><small>{roster.length} on shift</small></span>
          </button>
          {roster.map((r) => (
            <button type="button" class="con-agent" data-agent={r.id} aria-pressed="false">
              <span class="vg-glyph con-glyph"><Icon name={agent(r.id).icon} /></span>
              <span class="con-agent__text"><b>{agent(r.id).name}</b><small data-line={r.id}>{r.line}</small></span>
              <span class:list={['con-state', r.state === 'you' && 'is-you']} data-state={r.id} data-sr-you="Waiting on you" data-sr-ok="Working">
                <span class="sr-only">{r.state === 'you' ? 'Waiting on you' : 'Working'}</span>
              </span>
            </button>
          ))}
        </div>
        <div class="con-guard">
          <p><Icon name="shield-check" /><span><b>Guardrails on</b>First emails, refunds and moves between Google and Meta wait for your OK.</span></p>
        </div>
      </div>

      <div class="con-main">
        <div class="con-strip" role="group" aria-label="Filter by agent">
          <button type="button" class="con-chip" data-agent="all" aria-pressed="true"><Icon name="users" />All</button>
          {roster.map((r) => (
            <button type="button" class="con-chip" data-agent={r.id} aria-pressed="false">
              <Icon name={agent(r.id).icon} />{agentShort[r.id]}
              <span class:list={['con-chip__dot', r.state === 'you' && 'is-you']} data-state={r.id} data-sr-you=", waiting on you" data-sr-ok="">
                <span class="sr-only">{r.state === 'you' ? ', waiting on you' : ''}</span>
              </span>
            </button>
          ))}
        </div>

        <div class="con-head">
          <div class="con-head__text">
            <p class="con-head__title" data-view-title>Agent activity</p>
            <p class="con-head__sub" data-head-sub set:html={headSub} />
          </div>
          <Badge variant="running" icon="refresh-cw" class="con-tools con-wide">Connected to {toolCount} tools</Badge>
          <button type="button" class="app-btn con-clear" data-clear hidden><Icon name="x" />All agents</button>
        </div>

        <div class="con-kpis" data-kpis>
          <span class="fig-knot con-knot" aria-hidden="true">1</span>
          {kpiTiles.map((t, i) => (
            <div class="kpi" data-kpi={i}>
              <span class="kpi__label" data-k-label>{t.label}</span>
              <span class="kpi__value"><span class="num-tab" data-k-value data-n={t.n}>{fmtN(t.n, t.fmt)}</span><small data-k-unit>{unitText(t)}</small></span>
              <span class="kpi__delta" data-k-sub set:html={subHtml(t)} />
              {i === 0 && (
                <svg class="kpi__spark" viewBox="-3 -3 66 28" aria-hidden="true">
                  <path data-spark-ctx d={geo.ctx} fill="none" stroke="var(--viz-context)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                  <path data-spark-last d={geo.last} fill="none" stroke="var(--viz-accent)" stroke-width="2" stroke-linecap="round" />
                  <circle data-spark-dot cx={geo.dot[0]} cy={geo.dot[1]} r="3" fill="var(--viz-accent)" stroke="var(--color-navy-700)" stroke-width="2" />
                </svg>
              )}
            </div>
          ))}
        </div>

        <div class="con-card con-feed-card">
          <span class="fig-knot con-knot" aria-hidden="true">3</span>
          <div class="con-card__head">
            <span class="aw-label" id="con-log-label">Activity log</span>
            <span class="aw-seg con-tabs con-wide" role="tablist" aria-labelledby="con-log-label">
              {tabs.map((t, i) => (
                <button type="button" role="tab" id={`con-tab-${t.id}`} data-tab={t.id} aria-controls="con-log"
                  aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>{t.label}</button>
              ))}
            </span>
          </div>
          <div class="con-feed-wrap" id="con-log" role="tabpanel" aria-labelledby="con-tab-all" tabindex="0">
            <div class="con-feed-inner" data-feed-inner>
              <ol class="con-feed" data-feed aria-label="Log entries, newest first">
                {logRows.map((row) => <ConsoleRow row={row} time={rowTime(row)} hidden={!shown.has(row)} />)}
              </ol>
              <p class="con-feed-note" data-feed-note hidden>
                <span data-note-text></span>
                <button type="button" class="con-link" data-show-period></button>
              </p>
            </div>
          </div>
        </div>
      </div>

      <div class="con-rail" data-rail>
        <div class="con-card con-card--appr" role="group" aria-labelledby="con-appr-label">
          <span class="fig-knot con-knot" aria-hidden="true">2</span>
          <div class="con-card__head">
            <span class="aw-label" id="con-appr-label">Waiting on you</span>
            <span class="count" data-appr-count>{waiting}</span>
          </div>
          <div class="con-appr-box">
            <ul class="con-appr" data-appr-list>
              {approvals.map((a) => (
                <li class="con-appr__item" data-appr={a.id}>
                  <span class="con-appr__who"><span>{a.who}</span><Badge variant="attention">Your OK</Badge></span>
                  <p class="con-appr__what">{a.what}<span>{a.sub}</span></p>
                  <div class="con-appr__detail" id={`con-appr-${a.id}`} hidden>
                    {a.email && (
                      <>
                        <div class="aw-doc con-mail">
                          <p class="con-mail__to"><span>To</span> {a.email.to}</p>
                          <p class="con-mail__subject"><span>{a.email.subject}</span><small>Draft {a.email.draft}</small></p>
                          <div class="con-mail__body">
                            <p>{a.email.greeting}</p>
                            {a.email.body.map((p) => <p set:html={markers(p)} />)}
                            <p class="con-mail__sign">{a.email.signature}</p>
                            <p class="con-mail__opt">{a.email.optOut}</p>
                          </div>
                        </div>
                        <ol class="con-sources" aria-label="Sources">
                          {a.email.sources.map((s, i) => <li><span class="marker" aria-hidden="true">{i + 1}</span><span class="sr-only">Source {i + 1}: </span>{s}</li>)}
                        </ol>
                      </>
                    )}
                    {a.budget && (
                      <>
                        <table class="con-budget">
                          <thead><tr>{a.budget.head.map((c) => <th scope="col">{c}</th>)}</tr></thead>
                          <tbody>{a.budget.rows.map((r) => <tr><th scope="row">{r[0]}</th><td>{r[1]}</td><td>{r[2]}</td></tr>)}</tbody>
                        </table>
                        <p class="con-appr__note">{a.budget.why}</p>
                        <p class="con-appr__note"><b>The move:</b> {a.budget.plan}</p>
                        <p class="con-appr__note"><b>Estimate:</b> {a.budget.expect}</p>
                        <p class="math con-appr__math">{a.budget.math}</p>
                      </>
                    )}
                  </div>
                  <div class="con-appr__act">
                    <button type="button" class="app-btn con-review" data-review={a.id} aria-expanded="false" aria-controls={`con-appr-${a.id}`}>
                      Review<span class="sr-only">: {a.what}</span><Icon name="chevron-down" />
                    </button>
                    <span class="con-appr__decide">
                      <button type="button" class="app-btn con-decline" data-decide={a.id} data-outcome="declined">Decline<span class="sr-only">: {a.what}</span></button>
                      <button type="button" class="app-btn app-btn--primary" data-decide={a.id} data-outcome="approved">Approve<span class="sr-only">: {a.what}</span></button>
                    </span>
                  </div>
                </li>
              ))}
            </ul>
            <div class="con-appr__done" data-appr-done hidden>
              <span class="con-appr__done-icon"><Icon name="circle-check" size={28} /></span>
              <p><b>All caught up</b>Nothing is waiting on you. New requests show up here.</p>
              <button type="button" class="app-btn" data-reset><Icon name="rotate-ccw" />Reset the demo</button>
            </div>
          </div>
        </div>

        <div class="con-card con-card--hours">
          <div class="con-card__head"><span class="aw-label">Hours back by agent</span><span class="con-card__note" data-hours-note>{model.periods['7d'].label}</span></div>
          <ul class="con-hours">
            {hoursByAgent.map((a) => (
              <li class="con-hbar" data-hbar={a.id}>
                <span class="con-hbar__top"><span>{agent(a.id).name}</span><b><span class="num-tab" data-hbar-val data-n={a.hours}>{fmtH(a.hours)}</span> h</b></span>
                <span class="con-hbar__track"><span class="con-hbar__fill" data-hbar-fill style={`width:${((a.hours / maxHours) * 100).toFixed(1)}%`}></span></span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </div>

  <p class="sr-only" role="status" data-announce></p>

  <template data-live-rows>{liveRows.map((row) => <ConsoleRow row={row} />)}</template>
  <template data-decisions>{decisionRows.map((d) => <ConsoleRow row={d.row} decision={`${d.id}-${d.outcome}`} />)}</template>
  <template data-chip="approved"><Badge variant="done">Approved</Badge></template>
  <template data-chip="declined"><Badge variant="running" icon="x">Declined</Badge></template>
  <script type="application/json" is:inline data-console-model set:html={json} />

  <figcaption class="con-caption">
    <div class="con-legend">
      <ol class="fig-legend" aria-label="What the console shows">
        {legend.map((line, i) => <li><span class="fig-legend__n" aria-hidden="true">{i + 1}</span>{line}</li>)}
      </ol>
      <IllustrativeLabel />
    </div>
    <p class="fig-caption"><b>FIG. 1</b> The agent console with sample data. {business.name} is a fictional {business.employees}-person {business.kind}.</p>
    <p class="con-valmath"><span class="math">Value of the work = hours back × {currency(valueMath.rate)} + jobs recovered × {currency(valueMath.jobProfit, { cents: true })} ({currency(valueMath.call.price)} × {valueMath.call.margin}% gross profit). 30 days: {number(valueMath.hours30, 1)} h × {currency(valueMath.rate)} + {number(valueMath.jobsMonth, 1)} × {currency(valueMath.jobProfit, { cents: true })} ≈ {currency(valueMath.value30)}.</span> <a class="link" href={url('/results/#example-customer')}>See the full example</a></p>
  </figcaption>
</figure>

<script>
  import { initConsoles } from './console-app';
  initConsoles();
</script>

<style>
  /* ---- Figure and window ---------------------------------------------------------------- */
  .con-figure { position: relative; margin: 0; }
  .con-figure::before { content: ""; position: absolute; left: 12%; right: 12%; top: -40px; height: 160px; z-index: -1; background: radial-gradient(closest-side, rgb(209 174 108 / .22), transparent); filter: blur(24px); pointer-events: none; }

  .con-crumb :global(.brand) { gap: 0; }
  .con-crumb :global(.brand__mark) { width: 18px; height: 18px; }
  .con-crumb b { min-width: 0; overflow: hidden; text-overflow: ellipsis; }

  /* ---- Controls: shared states ------------------------------------------------------------ */
  .con-win button { cursor: pointer; }
  .con-win .aw-seg > button { transition: color .15s, background-color .15s; }
  .con-win .aw-seg > button:hover { color: var(--color-on); }
  .con-win .aw-seg > button:focus-visible, .con-agent:focus-visible, .con-chip:focus-visible { outline-offset: 2px; }
  .con-tabs > [aria-selected="true"] { color: var(--color-on); background: var(--color-navy-600); box-shadow: inset 0 0 0 1px var(--color-rule-dark-strong); }
  .con-win .app-btn { transition: color .15s, background-color .15s, box-shadow .15s; }
  .con-win .app-btn:not(.app-btn--primary):hover { color: var(--color-on); box-shadow: inset 0 0 0 1px rgb(224 191 127 / .5); }
  .con-win .app-btn--primary:hover { background: var(--color-white); }
  .con-win .app-btn :global(.icon) { width: 14px; height: 14px; }
  .con-live { height: 24px; margin: 0 -6px; padding: 0 6px; border-radius: 999px; transition: color .15s, background-color .15s; }
  .con-live:hover { background: rgb(255 255 255 / .05); }
  .con-live.is-held > i::after { animation: none; }
  .con-live.is-off { color: var(--color-on-3); }
  .con-live.is-off > i::after { animation: none; }

  .con-body { display: grid; grid-template-columns: 224px minmax(0, 1fr) 300px; }

  /* ---- Sidebar: agents on shift, each a filter ---------------------------------------- */
  .con-side { display: flex; flex-direction: column; min-height: 0; padding: 18px 12px 14px; background: var(--color-navy-850); border-right: 1px solid var(--color-rule-dark); }
  .con-side__head { display: flex; justify-content: space-between; align-items: center; padding: 0 8px 12px; font-size: 12px; color: var(--color-on-3); }
  .con-agents { display: grid; gap: 2px; }
  .con-agent { display: grid; grid-template-columns: 28px minmax(0, 1fr) 8px; align-items: center; gap: 8px 10px; width: 100%; padding: 8px; border-radius: 9px; text-align: left; transition: background-color .15s, box-shadow .15s; }
  .con-agent:hover { background: rgb(255 255 255 / .045); }
  .con-agent[aria-pressed="true"] { background: var(--color-navy-600); box-shadow: inset 0 0 0 1px var(--color-rule-dark-strong); }
  .con-agent__text { min-width: 0; line-height: 1.4; }
  .con-agent b { display: block; overflow: hidden; font-size: 13px; font-weight: 550; color: var(--color-on); white-space: nowrap; text-overflow: ellipsis; }
  .con-agent small { display: block; overflow: hidden; font-size: 12px; color: var(--color-on-3); white-space: nowrap; text-overflow: ellipsis; }
  .con-agent[aria-pressed="true"] small { color: var(--color-on-2); }
  .con-glyph { width: 28px; height: 28px; border-radius: 8px; }
  .con-glyph :global(.icon) { width: 14px; height: 14px; }
  .con-state { width: 7px; height: 7px; border-radius: 50%; background: var(--color-sage); box-shadow: 0 0 0 3px rgb(140 197 166 / .12); transition: background-color .3s; }
  .con-state.is-you { background: var(--color-sky); box-shadow: 0 0 0 3px rgb(143 184 224 / .16); }
  .con-guard { margin-top: auto; padding: 14px 8px 2px; border-top: 1px solid var(--color-rule-dark); }
  .con-guard p { display: flex; gap: 10px; font-size: 12px; line-height: 1.45; color: var(--color-on-3); }
  .con-guard b { display: block; font-size: 13px; font-weight: 550; color: var(--color-on); }
  .con-guard :global(.icon) { flex: none; margin-top: 1px; color: var(--color-brass-300); }

  /* ---- Main column ---------------------------------------------------------------------- */
  .con-main { min-width: 0; padding: 18px; }
  .con-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 16px; margin-bottom: 14px; }
  .con-head__text { min-width: 0; }
  .con-head__title { font-size: 17px; font-weight: 600; line-height: 1.2; letter-spacing: -.01em; color: var(--color-on); white-space: nowrap; }
  .con-head__sub { margin-top: 5px; overflow: hidden; font-size: 13px; line-height: 1.4; color: var(--color-on-3); white-space: nowrap; text-overflow: ellipsis; }
  .con-head__sub :global(b) { font-weight: 550; color: var(--color-on-2); }
  .con-head__sub :global(.you) { font-weight: 550; color: var(--color-sky); }
  .con-head :global(.con-tools) { flex: none; }
  .con-clear { flex: none; }

  /* Agent chips (below 1280px, where the sidebar hides) */
  .con-strip { display: none; gap: 6px; margin: -3px -3px 9px; padding: 3px; overflow-x: auto; scrollbar-width: none; -webkit-mask-image: linear-gradient(90deg, #000 88%, transparent); mask-image: linear-gradient(90deg, #000 88%, transparent); }
  .con-strip::-webkit-scrollbar { display: none; }
  .con-chip { position: relative; display: inline-flex; align-items: center; gap: 6px; flex: none; height: 32px; padding: 0 12px 0 10px; border-radius: 999px; font-size: 12px; font-weight: 550; color: var(--color-on-2); box-shadow: inset 0 0 0 1px var(--color-rule-dark-strong); transition: color .15s, background-color .15s, box-shadow .15s; }
  .con-chip:last-child { margin-right: 24px; }
  .con-chip:hover { color: var(--color-on); background: rgb(255 255 255 / .04); }
  .con-chip[aria-pressed="true"] { color: var(--color-on); background: var(--color-navy-600); box-shadow: inset 0 0 0 1px rgb(169 180 194 / .38); }
  .con-chip :global(.icon) { width: 13px; height: 13px; color: var(--color-brass-300); }
  .con-chip__dot { width: 6px; height: 6px; margin-left: 1px; border-radius: 50%; background: var(--color-sage); }
  .con-chip__dot.is-you { background: var(--color-sky); }

  .con-kpis { position: relative; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10px; margin-bottom: 14px; }
  .con-kpis .kpi__label, .con-kpis .kpi__delta { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .con-kpis .kpi__delta { display: block; }
  .con-kpis .kpi__delta :global(b) { margin-right: 5px; }
  .con-kpis .kpi__delta :global(.you) { font-weight: 550; color: var(--color-sky); }
  .con-kpis.is-swap .kpi > :not(.kpi__spark) { animation: con-swap .3s var(--ease-out-soft); }
  /* the sparkline sits beside the value, clear of the label and the delta line */
  .kpi__spark { position: absolute; top: 35px; right: 14px; width: 56px; height: 20px; }
  .kpi__spark path, .kpi__spark circle { transition: d .4s var(--ease-out-soft), cx .4s var(--ease-out-soft), cy .4s var(--ease-out-soft); }

  .con-card { position: relative; min-width: 0; border-radius: 12px; background: var(--color-navy-700); box-shadow: inset 0 0 0 1px var(--color-rule-dark), inset 0 1px 0 rgb(255 255 255 / .03); }
