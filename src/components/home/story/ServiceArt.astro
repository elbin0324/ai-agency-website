---
// The 40px service drawings that sit in a 56px navy .icon-tile (DESIGN.md §8.1 "Service art"):
// ivory strokes at 1.4px with one brass-filled element each. Network node (AI Agents), chart endpoint
// (Marketing Director), sealed envelope (Sales Agent), margin blocks (Consulting).
// Copied from the #services markup of design-lab/reference/index.html (DESIGN.md §8.1).
import type { ServiceSlug } from '@/data/services';

interface Props {
  slug: ServiceSlug;
  class?: string;
}
const { slug, class: className } = Astro.props;
---
<span class:list={['icon-tile', className]} aria-hidden="true">
  <svg viewBox="0 0 44 44" width="40" height="40" fill="none" stroke="currentColor" stroke-width="1.4" focusable="false">
    {slug === 'ai-agents' && (
      <Fragment>
        <path d="M22 12.5 12.5 30M22 12.5 31.5 30M12.5 30h19" stroke-opacity=".55" />
        <circle cx="22" cy="11" r="4.25" fill="#D1AE6C" stroke="#EBD6AC" />
        <circle cx="11.5" cy="31.5" r="4.25" fill="#10243B" />
        <circle cx="32.5" cy="31.5" r="4.25" fill="#10243B" />
      </Fragment>
    )}
    {slug === 'marketing' && (
      <Fragment>
        <path d="M7 36.5h30" stroke-opacity=".4" />
        <path d="M8 30.5 16 23l6 4.5 12-14" stroke-linecap="round" stroke-linejoin="round" />
        <circle cx="16" cy="23" r="2.25" fill="#10243B" />
        <circle cx="22" cy="27.5" r="2.25" fill="#10243B" />
        <circle cx="34.5" cy="12.5" r="3.75" fill="#D1AE6C" stroke="#EBD6AC" />
      </Fragment>
    )}
    {slug === 'sales' && (
      <Fragment>
        <rect x="7" y="11.5" width="30" height="21" rx="2.5" />
        <path d="M7.8 12.6 22 23.5l14.2-10.9" stroke-linejoin="round" />
        <circle cx="22" cy="24.5" r="4.5" fill="#D1AE6C" stroke="#EBD6AC" />
        <path d="M20.2 24.6l1.3 1.3 2.4-2.6" stroke="#0E2136" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" />
      </Fragment>
    )}
    {slug === 'consulting' && (
      <Fragment>
        <path d="M7 36.5h30" stroke-opacity=".4" />
        <rect x="8.5" y="22" width="5" height="14.5" rx="1" />
        <rect x="15.5" y="17.5" width="5" height="4.5" rx="1" />
        <rect x="22.5" y="13" width="5" height="4.5" rx="1" />
        <path d="M13.5 22h2M20.5 17.5h2M27.5 13h2" stroke-opacity=".55" />
        <rect x="29.5" y="13" width="5" height="23.5" rx="1" fill="#D1AE6C" stroke="#EBD6AC" />
      </Fragment>
    )}
  </svg>
</span>
