---
// Consulting-cost teaser under the Why-us comparison (COPY.md §2.9, DECISIONS.md 2026-10-12/13):
// a two-row cost ledger (DESIGN.md §6.18) that previews /services/consulting/#comparison.
// Compares scope, price and time, never outcomes. Traditional figures come from src/data/consulting.ts:
// the lowest modeled total for this scope and the shortest published time to recommendations.
// Our row shows no price while site.consultingPrice is null ("a fraction of the cost" is allowed).
import Icon from '@/components/ui/Icon.astro';
import IllustrativeLabel from '@/components/ui/IllustrativeLabel.astro';
import Logo from '@/components/ui/Logo.astro';
import { providers, ours } from '@/data/consulting';
import { site } from '@/config/site';
import { url } from '@/lib/url';
import { currency } from '@/lib/format';

const compareHref = '/services/consulting/#comparison';

// Lowest fixed-price total among the traditional categories (an independent consultant, modeled),
// and its math, parsed from the provider's own cost line ("$130 to $175/hr x 120 to 180 hours").
const priced = providers.filter((p) => p.costLow > 0);
const cheapest = priced.reduce((a, b) => (b.costLow < a.costLow ? b : a), priced[0]);
const m = cheapest.cost.match(/\$(\d[\d,]*) to \$\d[\d,]*\/hr x (\d+) to \d+ hours/);
const rate = m ? Number(m[1].replace(/,/g, '')) : 0;
const hours = m ? Number(m[2]) : 0;
const mathOk = rate > 0 && rate * hours === cheapest.costLow;

// Time to recommendations, in weeks, on a shared 0-20 week axis.
const spans = providers
  .map((p) => p.time.match(/^(\d+) to (\d+)\+? weeks/))
  .filter((x): x is RegExpMatchArray => !!x)
  .map((x) => Number(x[1]));
const minWeeks = spans.length ? Math.min(...spans) : 8;
const ourSpan = ours.time.match(/(\d+) to (\d+) weeks/);
const [ourFrom, ourTo] = ourSpan ? [Number(ourSpan[1]), Number(ourSpan[2])] : [3, 5];
const AXIS = 20;
const at = (w: number) => `${((w / AXIS) * 100).toFixed(1)}%`;

const usPrice = site.consultingPrice
  ? { fig: `${currency(site.consultingPrice.from)} to ${currency(site.consultingPrice.to)}`, note: 'Fixed fee for the agreed scope' }
  : { fig: 'Fixed fee, scoped after a free assessment', note: 'A fraction of the cost of a traditional engagement' };
---
<div class="consult" data-reveal>
  <div class="consult__copy">
    <p class="type-label">Considering a consultant first?</p>
    <h3 class="type-h3 consult__title">The same core deliverable, at a fraction of the cost.</h3>
    <p class="consult__body">
      A diagnostic and a prioritized roadmap usually means weeks of analysts billing for hours in your
      spreadsheets. Here, AI does the reading and the modeling, and a person checks every finding.
    </p>
    <a class="link-arrow" href={url(compareHref)}><span>Compare the options</span><Icon name="arrow-right" /></a>
  </div>

  <div class="consult__table">
    <table class="cost-ledger">
      <caption class="sr-only">A traditional review and {site.name} AI Consulting, for the same scope of work</caption>
      <thead>
        <tr>
          <th scope="col"><span class="sr-only">Who does it</span></th>
          <th scope="col">Time to recommendations<span class="cost-ledger__axis" aria-hidden="true"><span>0</span><span>10</span><span>{AXIS} weeks</span></span></th>
          <th scope="col">Cost for the same scope</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <th scope="row"><span class="cost-ledger__name">Traditional review</span><span class="cost-ledger__sub">Independent consultant or consulting firm</span></th>
          <td data-label="Time to recommendations">
            <span class="cost-ledger__fig">{minWeeks} weeks or more</span>
            <span class="range-bar is-open" aria-hidden="true"><span class="range-bar__fill" style={`--from:${at(minWeeks)}`}></span></span>
          </td>
          <td data-label="Cost for the same scope"><span class="cost-ledger__fig">{currency(cheapest.costLow)} and up</span><span class="cost-ledger__note">Larger firms cost several times that</span></td>
        </tr>
        <tr class="is-us ctx-dark">
          <th scope="row"><span class="cost-ledger__name"><span class="consult__mark" aria-hidden="true"><Logo variant="dark" href={null} wordmark={false} size={18} /></span><span>{site.name} AI Consulting</span></span></th>
          <td data-label="Time to recommendations">
            <span class="cost-ledger__fig">Typically {ourFrom} to {ourTo} weeks</span>
            <span class="range-bar range-bar--us" aria-hidden="true"><span class="range-bar__fill" style={`--from:${at(ourFrom)};--to:${at(ourTo)}`}></span></span>
          </td>
          <td data-label="Cost for the same scope"><span class="cost-ledger__fig">{usPrice.fig}</span><span class="cost-ledger__note consult__us-note">{usPrice.note}</span></td>
        </tr>
      </tbody>
    </table>
    <div class="cmp-foot">
      <IllustrativeLabel kind="Modeled estimate" href={compareHref} />
      <p>
        {mathOk ? <Fragment><span class="math">{currency(rate)}/hr × {hours} hours = {currency(cheapest.costLow)}</span>, the low end for an independent consultant. </Fragment> : null}
        Typical market costs from public records, 2021 to 2026. Sources on the AI Consulting page.
      </p>
    </div>
  </div>
</div>

<style>
  .consult { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 32px 24px; margin-top: clamp(56px, 7vw, 88px); padding-top: 32px; border-top: 1px solid var(--line-strong); }
  .consult__copy { grid-column: 1 / span 4; }
  .consult__title { margin-top: 14px; text-wrap: balance; }
  .consult__body { margin-top: 14px; max-width: 44ch; font-size: 0.9375rem; line-height: 1.6; color: var(--fg-2); }
  .consult__copy .link-arrow { margin-top: 10px; }
  .consult__table { grid-column: 6 / span 7; }
  .consult__table .cost-ledger tbody th { width: 34%; }
  .consult__table .cost-ledger thead th:nth-child(2) { width: 36%; }
  .consult__table .cost-ledger thead th:nth-child(3) { width: auto; }
  .consult__mark { display: inline-flex; }
  .consult__mark :global(.brand) { gap: 0; }
  .consult__us-note { color: var(--color-on-2); }
  .consult__table .cmp-foot .math { font-size: inherit; }

  /* Stack under 1280px so the ledger keeps its full width and our row stays one line per value. */
  @media (width < 80rem) {
    .consult { row-gap: 24px; }
    .consult__copy, .consult__table { grid-column: 1 / -1; }
    .consult__copy { display: grid; grid-template-columns: minmax(0, 1fr); max-width: 62ch; }
    .consult__title { max-width: 28ch; }
  }
  @media (width < 48rem) {
    .consult__table .cost-ledger tbody th { width: auto; }
  }
</style>
