---
// The "rising H" mark plus the wordmark from site.name (DESIGN.md §8.2). Never typed, never an image.
//   variant 'light' (on paper: ink stems, brass-500 crossbar) · 'dark' (on navy: ivory stems, brass-400 crossbar)
//   href: home by default; href={null} renders a non-link (e.g. inside another link).
//   wordmark={false}: the mark alone (minimum 20px). size: mark size in px (CSS default 30px, 26px under 640px).
import { site } from '@/config/site';
import { url } from '@/lib/url';

interface Props {
  variant?: 'light' | 'dark';
  href?: string | null;
  wordmark?: boolean;
  size?: number;
  class?: string;
}
const { variant = 'light', href = '/', wordmark = true, size, class: className } = Astro.props;
const Tag = href ? 'a' : 'span';
const style = variant === 'dark' ? 'color: var(--color-on); --mark-accent: var(--color-brass-400);' : undefined;
const markStyle = size ? `width:${size}px;height:${size}px` : undefined;
const attrs = href
  ? { href: url(href), 'aria-label': `${site.name}, home` }
  : wordmark
    ? {}
    : { role: 'img', 'aria-label': site.name };
---
<Tag class:list={['brand', className]} style={style} {...attrs}>
  <svg class="brand__mark" viewBox="0 0 32 32" aria-hidden="true" style={markStyle}>
    <rect x="6" y="10" width="4" height="17" rx=".6" fill="currentColor" />
    <rect x="22" y="4" width="4" height="23" rx=".6" fill="currentColor" />
    <path d="M10 19.2 22 11.2v4.4l-12 8z" fill="var(--mark-accent, var(--color-brass-500))" />
  </svg>
  {wordmark && <span class="brand__word">{site.name}</span>}
</Tag>
