---
// Mono brass overline with a 32px leading dash (DESIGN.md §6.3). Only above hero and
// page-hero H1s; section titles use the SectionHeader rule instead.
interface Props {
  as?: 'p' | 'span' | 'div';
  class?: string;
}
const { as: Tag = 'p', class: className } = Astro.props;
---
<Tag class:list={['eyebrow', className]}><slot /></Tag>
