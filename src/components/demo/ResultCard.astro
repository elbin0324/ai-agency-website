---
// Result card: the end of every demo (DESIGN.md §6.12, DEMOS.md §0.5, COPY.md §8.9). OWNER: demo engine.
// Usually rendered by AppWindow through its `result` prop; standalone use is fine anywhere on paper.
// Inside an AppWindow the engine keeps it hidden until the last step calls ctx.showResult(): the card
// slides up, its brass rule draws in and every number in each value counts up.
//
//   <ResultCard
//     metrics={[{ value: '34', unit: 'min', label: 'Saved each week', basis: '40 min by hand vs 6 min with review.' }, …]}
//     label="Illustrative example"            // Consulting: ['Illustrative example', 'Modeled estimate']
//     note="Assumptions: …" />
import IllustrativeLabel from '@/components/ui/IllustrativeLabel.astro';
import Button from '@/components/ui/Button.astro';
import { site } from '@/config/site';
import { url } from '@/lib/url';
import { referencedIds } from '@/components/results/sources';
import { sources } from '@/data/benchmarks';
import type { ResultCardProps } from './types';
import './demo.css';

type Props = ResultCardProps;

const {
  metrics,
  label = 'Illustrative example',
  note,
  title,
  context,
  heading = 'Result',
  headingLevel = 3,
  mathHref = '/results/#examples',
  mathLabel = 'See the math',
  replay = true,
  cta = true,
  class: className,
} = Astro.props;
const labels = Array.isArray(label) ? label : [label];
const H = `h${headingLevel}` as 'h2' | 'h3' | 'h4';

// Internal source ids in a basis line ("… (cx-20, cx-18).", "(… typical, time-01)", "(time-01: …)") read
// like editor notes, so they move out of the sentence into a plain "2 sources" line under it. It links to the
// first of them that the methodology on /results/ lists (referencedIds), or to the methodology when none is
// listed; the publications' short names sit in its title. Demo data may put a word joiner after the hyphen
// ("cx-⁠20"), so the pattern allows one.
const ID = String.raw`[a-z]+-⁠?\d+`;
const idOnlyGroup = new RegExp(String.raw`\s*\((${ID}(?:,\s*${ID})*)\)`, 'g');
const idAtGroupEnd = new RegExp(String.raw`[,;]\s*(${ID})(?=\))`, 'g');
const idAtGroupStart = new RegExp(String.raw`(?<=\()(${ID}):\s*`, 'g');
const listed = referencedIds();
function splitBasis(basis: string) {
  const ids: string[] = [];
  const take = (group: string) => {
    for (const raw of group.split(/,\s*/)) {
      const id = raw.replace(/⁠/g, '');
      if (!ids.includes(id)) ids.push(id);
    }
    return '';
  };
  const text = basis
    .replace(idOnlyGroup, (_m, g: string) => take(g))
    .replace(idAtGroupEnd, (_m, g: string) => take(g))
    .replace(idAtGroupStart, (_m, g: string) => take(g))
    .replace(/\s+([,;.])/g, '$1')
    .trim();
  return { text, ids };
}
// "Hennessey Digital, 2025 Lead Form …" -> "Hennessey Digital": the publication, for the tooltip.
const shortName = (id: string) => sources.find((s) => s.id === id)?.citation.split(',')[0]?.trim() ?? id;
const tiles = metrics.map((m) => {
  const { text, ids } = splitBasis(m.basis);
  const first = ids.find((id) => listed.has(id));
  return {
    ...m,
    text,
    ids,
    srcLabel: `${ids.length} source${ids.length === 1 ? '' : 's'}`,
    srcHref: first ? `/results/#src-${first}` : '/results/#methodology',
    srcNames: ids.map(shortName).join('; '),
  };
});
---
<article class:list={['result-card', className]} data-result-card>
  <div class="result-card__top">
    <H class="type-h4">{heading}</H>
    <div class="tag-row">{labels.map((kind) => <IllustrativeLabel kind={kind} />)}</div>
  </div>
  {context && <p class="result-card__ctx">{context}</p>}
  {title && <p class="result-card__title">{title}</p>}
  <div class="result-tiles">
    {tiles.map((m) => (
      <div class="result-tile" data-sources={m.ids.length ? m.ids.join(' ') : undefined}>
        <span class="result-tile__v"><span data-result-count={m.count === false ? undefined : ''}>{m.value}</span>{m.unit && <small>{m.unit}</small>}</span>
        <span class="result-tile__k">{m.label}</span>
        <span class="result-tile__basis">{m.text}</span>
        {m.ids.length > 0 && (
          <span class="result-tile__src">
            <a class="link" href={url(m.srcHref)} title={m.srcNames}>{m.srcLabel}</a>
          </span>
        )}
      </div>
    ))}
  </div>
  {note && <p class="math result-card__note">{note}</p>}
  <div class="result-card__foot">
    <a class="link result-card__math" href={url(mathHref)}>{mathLabel}</a>
    {replay && <Button variant="secondary" size="sm" icon="rotate-ccw" data-demo-replay>Replay</Button>}
    {cta && <Button href={site.cta.href} size="sm" icon="arrow-right">{site.cta.label}</Button>}
  </div>
</article>

<style>
  .result-card__note { margin-top: 14px; }
  .result-card__math { font-size: 0.875rem; }
  .result-tile__src { display: block; margin-top: 4px; font-size: 0.8125rem; line-height: 1.5; color: var(--color-ink-3); }
  .result-tile__src a { white-space: nowrap; }
</style>
